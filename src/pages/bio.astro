---
import SiteHeader from "../components/SiteHeader.astro";
import GlobalMixcloudPlayer from "../components/GlobalMixcloudPlayer.astro";
import HubSpotTracking from "../components/HubSpotTracking.astro";
import MetaPixel from "../components/MetaPixel.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Itchy Lemon is a Portuguese DJ and electronic music producer. Discover international appearances, venues across Portugal, radio residencies, artist profiles and booking information."
    />
    <meta name="author" content="Itchy Lemon" />
    <meta name="theme-color" content="#07090c" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bio | Itchy Lemon</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://itchylemon.com/bio/" />

    <style>
      :root {
        --bg: #07090c;
        --bg-soft: #10141b;
        --text: #f4f4f0;
        --muted: #a7adb8;
        --acid: #d8ff3e;
        --line: rgba(255, 255, 255, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background:
          radial-gradient(circle at top right, rgba(216, 255, 62, 0.12), transparent 34%),
          linear-gradient(135deg, #07090c 0%, #111827 48%, #050608 100%);
        color: var(--text);
        min-height: 100vh;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        min-height: 100vh;
        padding: 32px;
      }

      main {
        max-width: 1080px;
        margin: 0 auto;
      }

      .eyebrow {
        color: var(--acid);
        text-transform: uppercase;
        letter-spacing: 0.24em;
        font-size: 13px;
        margin-bottom: 18px;
      }

      h1 {
        margin: 0;
        font-size: clamp(48px, 8vw, 104px);
        line-height: 0.9;
        letter-spacing: -0.06em;
        text-transform: uppercase;
      }

      .lead {
        margin-top: 32px;
        max-width: 780px;
        font-size: clamp(22px, 3vw, 34px);
        line-height: 1.16;
        color: var(--acid);
      }

      .content-grid {
        display: grid;
        grid-template-columns: 0.75fr 1.25fr;
        gap: 48px;
        margin-top: 72px;
      }

      .panel {
        border: 1px solid var(--line);
        background: rgba(16, 20, 27, 0.72);
        border-radius: 28px;
        padding: 28px;
        height: fit-content;
        backdrop-filter: blur(12px);
      }

      .panel h2,
      .text-block h2 {
        margin: 0 0 18px;
        font-size: 13px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--acid);
      }

      .highlight-list {
        display: grid;
        gap: 18px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .highlight-list li {
        border-top: 1px solid var(--line);
        padding-top: 16px;
        color: var(--muted);
        line-height: 1.55;
      }

      .highlight-list strong {
        display: block;
        color: var(--text);
        margin-bottom: 4px;
      }

      .text-block {
        color: var(--muted);
        font-size: 17px;
        line-height: 1.75;
      }

      .text-block p {
        margin: 0 0 22px;
      }

      .text-block strong {
        color: var(--text);
      }

      .quote {
        margin-top: 38px;
        border-left: 2px solid var(--acid);
        padding-left: 22px;
        color: var(--text);
        font-size: 24px;
        line-height: 1.25;
        letter-spacing: -0.02em;
      }

      .bio-industry { margin-top:32px; padding:24px; border:1px solid var(--line); border-radius:24px; background:rgba(16,20,27,.52); }
      .bio-industry h2 { margin:0 0 14px; font-size:13px; line-height:1.5; text-transform:uppercase; letter-spacing:.18em; color:var(--acid); }
      .bio-industry p { margin:0 0 18px; color:var(--muted); font-size:14px; line-height:1.7; }
      .bio-industry p strong { color:var(--text); }
      .bio-industry-links { display:flex; flex-wrap:wrap; gap:8px; }
      .bio-industry-links a { display:inline-flex; align-items:center; gap:7px; padding:10px 12px; border:1px solid rgba(216,255,62,.26); border-radius:999px; font-size:12px; font-weight:700; color:var(--acid); line-height:1.3; }
      .bio-industry-links a:hover,.bio-industry-links a:focus-visible { border-color:var(--acid); background:rgba(216,255,62,.06); }
      .bio-industry-epk { display:inline-flex; gap:8px; margin-top:18px; font-size:12px; color:var(--text); text-decoration:underline; text-decoration-color:rgba(216,255,62,.6); text-underline-offset:5px; }
      .bio-industry-epk:hover { color:var(--acid); }
      @media(max-width:600px) { .bio-industry { padding:20px; } .bio-industry-links { flex-direction:column; align-items:stretch; } .bio-industry-links a { justify-content:space-between; } }

      .bio-links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 34px;
      }

      .bio-link {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 11px 15px;
        color: var(--muted);
        font-size: 13px;
      }

      .bio-link:hover {
        color: #050608;
        background: var(--acid);
        border-color: var(--acid);
      }

      .bio-primary-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:30px; }
      .primary-action,.secondary-action { display:inline-flex; align-items:center; justify-content:center; gap:18px; padding:14px 20px; border-radius:999px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; transition:transform .2s,background .2s; }
      .primary-action { background:var(--acid); color:#050608; border:1px solid var(--acid); }
      .secondary-action { border:1px solid rgba(216,255,62,.5); color:var(--text); }
      .primary-action:hover,.secondary-action:hover { transform:translateY(-2px); }
      .secondary-action:hover { background:rgba(216,255,62,.08); }
      .milestone-year { display:block; margin-bottom:6px; color:var(--acid); text-transform:uppercase; font-size:11px; letter-spacing:.13em; }
      .milestone-link { display:block; width:fit-content; margin-top:8px; color:var(--acid); font-size:12px; text-decoration:underline; text-underline-offset:4px; }
      .milestone-link:hover,.panel-footer-link:hover { color:var(--text); }
      .panel-footer-link { display:inline-flex; gap:10px; margin-top:25px; font-size:12px; color:var(--acid); font-weight:700; text-decoration:underline; text-underline-offset:5px; }
      .bio-narrative { min-width:0; }
      .quick-bio { margin-top:38px; padding:26px; border:1px solid var(--line); background:rgba(16,20,27,.55); border-radius:24px; }
      .quick-bio h2 { margin:0 0 16px; color:var(--acid); text-transform:uppercase; letter-spacing:.18em; font-size:13px; }
      .quick-bio p { margin:0; color:var(--text); font-size:16px; line-height:1.7; }
      .quick-bio .quick-bio-note { margin-top:14px; color:var(--muted); font-size:13px; }
      .highlight-list li { font-size:14px; }
      @media(max-width:600px) { .bio-primary-actions { flex-direction:column; } .primary-action,.secondary-action { width:100%; } .quick-bio { padding:20px; } .content-grid { gap:26px; } }
      .venues-section { margin-top:78px; padding-top:44px; border-top:1px solid var(--line); }
      .venues-heading { display:grid; grid-template-columns:1fr 1fr; align-items:end; gap:36px; }
      .venues-heading .eyebrow { margin:0 0 12px; }
      .venues-heading h2 { margin:0; font-size:clamp(32px,5vw,60px); letter-spacing:-.055em; line-height:1.02; }
      .venues-heading > p { margin:0; color:var(--muted); font-size:15px; line-height:1.6; }
      .venues-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; margin-top:30px; }
      .venues-column { padding:24px; min-width:0; border:1px solid var(--line); border-radius:22px; background:rgba(16,20,27,.55); }
      .venues-column h3 { margin:0 0 20px; font-size:12px; color:var(--acid); text-transform:uppercase; letter-spacing:.15em; }
      .venues-column ul { margin:0; padding:0; list-style:none; }
      .venues-column li { padding:11px 0; border-top:1px solid var(--line); }
      .venues-column li strong { display:block; font-size:14px; font-weight:700; color:var(--text); line-height:1.4; }
      .venues-column li span { display:block; margin-top:4px; font-size:12px; line-height:1.5; color:var(--muted); }
      .venues-action { display:inline-flex; margin-top:24px; padding-bottom:4px; border-bottom:1px solid rgba(216,255,62,.5); color:var(--acid); font-size:12px; font-weight:700; line-height:1.5; }
      .venues-action:hover { color:var(--text); border-bottom-color:var(--acid); }
      @media(max-width:860px) { .venues-heading { grid-template-columns:1fr; gap:16px; } .venues-grid { grid-template-columns:1fr 1fr; } }
      @media(max-width:600px) { .venues-section { margin-top:55px; } .venues-grid { grid-template-columns:1fr; gap:14px; } .venues-column { padding:20px; } }
      footer {
        max-width: 1080px;
        margin: 80px auto 0;
        color: var(--muted);
        font-size: 12px;
        padding-top: 28px;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        gap: 20px;
      }

      footer a {
        color: var(--muted);
      }

      footer a:hover {
        color: var(--acid);
      }

      @media (max-width: 1024px) {
        .page {
          padding: 22px;
        }

        footer {
          flex-direction: column;
        }
      }

      @media (max-width: 860px) {
        .content-grid {
          grid-template-columns: 1fr;
          gap: 32px;
          margin-top: 48px;
        }
      }
    </style>
  </head>

  <body>
    <div class="page">
      <SiteHeader activePage="bio" />

      <main>
        <p class="eyebrow">Artist Biography</p>

        <h1>Bio</h1>

        <p class="lead">
          From the dancefloors of Portugal, London, Amsterdam and Luxembourg to a new wave of original releases and radio residencies, Itchy Lemon brings deep grooves, melodic tension and a distinctive sense of movement to every set.
        </p>

        <div class="bio-primary-actions" aria-label="Artist essentials">
          <a class="primary-action" href="/press-kit/">Explore Press Kit <span aria-hidden="true">↗</span></a>
          <a class="secondary-action" href="/booking/">Booking enquiries <span aria-hidden="true">↗</span></a>
        </div>

        <section class="content-grid" aria-label="Artist biography">
          <aside class="panel">
            <h2>Selected milestones</h2>
            <ul class="highlight-list">
              <li><span class="milestone-year">2026 · Porto</span><strong>Calico</strong>Resident DJ since August 2026.</li>
              <li><span class="milestone-year">2026 · Radio</span><strong>Ibiza Stardust Radio</strong>Resident DJ since October 2026. <a class="milestone-link" href="https://soundcloud.com/ibizastardustradio/itchy-lemon-fresh-beats-42" target="_blank" rel="noopener noreferrer">Listen to Fresh Beats #42 ↗</a></li>
              <li><span class="milestone-year">2026 · Radio</span><strong>Pinnacle Nexus Radio</strong>Original productions featured in World Groove rotation.</li>
              <li><span class="milestone-year">2015 · Porto</span><strong>Orange Room</strong>Recorded DJ session in an intimate, performance-led format. <a class="milestone-link" href="https://www.mixcloud.com/ITCHY_LEMON_DjProducer/itchy-lemon-fresh-beats-40-rec-live-at-orange-room-porto-studio-series-episode-108-dec-2015/" target="_blank" rel="noopener noreferrer">Listen to the recorded set ↗</a></li>
              <li><span class="milestone-year">2015 · London</span><strong>The Qube Project</strong>DJ appearance · 7 February. <a class="milestone-link" href="https://ra.co/events/671935" target="_blank" rel="noopener noreferrer">Event lineup ↗</a></li>
              <li><span class="milestone-year">2014 · London</span><strong>Ministry of Sound</strong>DJ appearance · 26 December. <a class="milestone-link" href="https://www.fatsoma.com/e/tum8nley/la-bomba" target="_blank" rel="noopener noreferrer">Event listing ↗</a></li>
            </ul>
            <a class="panel-footer-link" href="/press-kit/#highlights">Credentials &amp; evidence <span aria-hidden="true">↗</span></a>
          </aside>

          <div class="bio-narrative">
            <section class="text-block">
              <h2>The artist</h2>
              <p>
                <strong>Itchy Lemon</strong> is a Portuguese DJ and electronic music producer whose artistic journey connects club culture, original music and a distinct sense of atmosphere. Rooted in groove and driven by melodic tension, his sets move naturally between depth, movement and emotional intensity.
              </p>
              <p>
                His international DJ journey includes appearances at <strong>Ministry of Sound</strong> and <strong>The Qube Project</strong> in London, <strong>Players</strong> in Amsterdam and <strong>Marx</strong> in Luxembourg, alongside performances at some of Portugal's most recognised venues, including <strong>Coliseu do Porto</strong>, <strong>Hard Club</strong> and <strong>Rivoli</strong>. His story also includes an interview and live radio performance on <strong>The Beat London FM</strong>.
              </p>
              <p>
                In 2026, Itchy Lemon entered a new creative chapter: a DJ residency at <strong>Calico Porto</strong>, a monthly radio residency with <strong>Ibiza Stardust Radio</strong> and original productions receiving rotation on <strong>Pinnacle Nexus Radio</strong>.
              </p>
              <p>
                As a producer, he develops original tracks and remixes that balance rhythmic drive with carefully built atmosphere. Behind the decks and in the studio, the focus remains the same: <strong>music that creates connection without losing its edge.</strong>
              </p>
              <div class="quote">Deep grooves. Melodic tension. A sound that stays with you.</div>
            </section>

            <section class="quick-bio" aria-labelledby="quick-bio-title">
              <h2 id="quick-bio-title">Short bio</h2>
              <p>Itchy Lemon is a Portuguese DJ and electronic music producer whose international path includes Ministry of Sound and The Qube Project in London, Players in Amsterdam and Marx in Luxembourg. With appearances at venues across Portugal, a residency at Calico Porto and a radio residency with Ibiza Stardust Radio, his sound blends deep grooves, melodic tension and an instinctive approach to the dancefloor.</p>
              <p class="quick-bio-note">For promoters, media and collaborators: discover the full artist press kit, official releases and booking information below.</p>
            </section>

            <section class="bio-industry" aria-labelledby="bio-industry-title">
              <h2 id="bio-industry-title">Historical artist profiles</h2>
              <p>Itchy Lemon's earlier journey is also documented through artist biographies on the <strong>Amsterdam Dance Event</strong> website, <strong>Resident Advisor</strong> and <strong>Central de Artistas</strong>. These historical listings reflect a career across clubs, productions and radio, and are distinct from confirmations of individual performances.</p>
              <div class="bio-industry-links" aria-label="Historical professional artist profiles">
                <a href="https://www.amsterdam-dance-event.nl/en/artists-speakers/itchy-lemon/20886/" target="_blank" rel="noopener noreferrer">Amsterdam Dance Event <span aria-hidden="true">↗</span></a>
                <a href="https://ra.co/dj/itchylemon/biography" target="_blank" rel="noopener noreferrer">Resident Advisor <span aria-hidden="true">↗</span></a>
                <a href="https://centraldeartistas.pt/index.php?Itemid=96&amp;link_id=927&amp;option=com_mtree&amp;task=viewlink" target="_blank" rel="noopener noreferrer">Central de Artistas <span aria-hidden="true">↗</span></a>
              </div>
              <a class="bio-industry-epk" href="/press-kit/#industry-profiles">Explore the documented artist references <span aria-hidden="true">↗</span></a>
            </section>

            <div class="bio-links" aria-label="Artist links">
              <a class="bio-link" href="/press-kit/">Press Kit</a>
              <a class="bio-link" href="/sets/">DJ Sets</a>
              <a class="bio-link" href="/discography/">Discography</a>
              <a class="bio-link" href="/booking/">Booking</a>
              <a class="bio-link" href="https://open.spotify.com/artist/5IfFyzIiz1iBO7RZUJyFen" target="_blank" rel="noopener noreferrer">Spotify ↗</a>
              <a class="bio-link" href="https://www.instagram.com/itchy_lemon/" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
            </div>
          </div>
        </section>

        <section class="venues-section" aria-labelledby="venues-title">
          <div class="venues-heading">
            <div>
              <p class="eyebrow">Selected appearances</p>
              <h2 id="venues-title">Beyond the studio.</h2>
            </div>
            <p>Club stages, cultural venues and radio sessions across Europe. A selection from the Itchy Lemon journey.</p>
          </div>
          <div class="venues-grid">
            <div class="venues-column">
              <h3>International</h3>
              <ul>
                <li><strong>Ministry of Sound</strong><span>London, UK</span></li>
                <li><strong>The Qube Project</strong><span>London, UK · 7 February 2015</span><a class="milestone-link" href="https://ra.co/events/671935" target="_blank" rel="noopener noreferrer">Event lineup ↗</a></li>
                <li><strong>Players</strong><span>Amsterdam, Netherlands</span></li>
                <li><strong>Marx</strong><span>Luxembourg</span></li>
                <li><strong>Thirty3Hertz</strong><span>Guildford, UK · 27 May 2016</span><a class="milestone-link" href="https://es-mx.ra.co/events/829631" target="_blank" rel="noopener noreferrer">Event lineup ↗</a></li>
              </ul>
            </div>
            <div class="venues-column">
              <h3>Portugal</h3>
              <ul>
                <li><strong>Coliseu do Porto</strong><span>Porto</span></li>
                <li><strong>Hard Club</strong><span>Portugal</span></li>
                <li><strong>Rivoli</strong><span>Portugal</span></li>
                <li><strong>Kasa Da Praia</strong><span>Portugal</span></li>
                <li><strong>Twins</strong><span>Portugal</span></li>
                <li><strong>Manta Beach</strong><span>Portugal</span></li>
                <li><strong>Zoom Club</strong><span>Portugal</span></li>
                <li><strong>Radio Bar</strong><span>Porto · 27 May 2017</span><a class="milestone-link" href="https://ra.co/events/974813" target="_blank" rel="noopener noreferrer">Event listing ↗</a></li>
              </ul>
            </div>
            <div class="venues-column">
              <h3>Sessions &amp; radio</h3>
              <ul>
                <li><strong>The Beat London FM</strong><span>London, UK · Interview + live radio performance</span></li>
                <li><strong>Orange Room</strong><span>Porto · Intimate recorded DJ session</span></li>
              </ul>
              <a class="venues-action" href="/press-kit/">Explore the artist press kit <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </section>
      </main>

      <footer>
        <span>© 2026 Itchy Lemon. All rights reserved.</span>
        <span>
          Official Website & EPK · Portugal ·
          <a href="/privacy-policy">Privacy Policy</a>
        </span>
      </footer>
    </div>

    <MetaPixel />
    <GlobalMixcloudPlayer />
    <HubSpotTracking />
  </body>
</html>