---
import SiteHeader from "../components/SiteHeader.astro";
import { latestRelease, previousReleases } from "../data/originalReleases";
import GlobalMixcloudPlayer from "../components/GlobalMixcloudPlayer.astro";
import HubSpotTracking from "../components/HubSpotTracking.astro";
import MetaPixel from "../components/MetaPixel.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Press kit for Itchy Lemon — artist bio, music links, DJ sets, booking contact and essential information for promoters, curators and collaborators."
    />
    <meta name="author" content="Itchy Lemon" />
    <meta name="theme-color" content="#07090c" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Press Kit | Itchy Lemon</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://itchylemon.com/press-kit/" />

    <style>
      :root {
        --bg: #07090c;
        --bg-soft: #10141b;
        --text: #f4f4f0;
        --muted: #a7adb8;
        --acid: #d8ff3e;
        --line: rgba(255, 255, 255, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background:
          radial-gradient(circle at top right, rgba(216, 255, 62, 0.12), transparent 34%),
          linear-gradient(135deg, #07090c 0%, #111827 48%, #050608 100%);
        color: var(--text);
        min-height: 100vh;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        font: inherit;
      }

      .page {
        min-height: 100vh;
        padding: 32px;
      }

      main {
        max-width: 1080px;
        margin: 0 auto;
      }

      .eyebrow {
        color: var(--acid);
        text-transform: uppercase;
        letter-spacing: 0.24em;
        font-size: 13px;
        margin-bottom: 18px;
      }

      h1 {
        margin: 0;
        font-size: clamp(48px, 8vw, 104px);
        line-height: 0.9;
        letter-spacing: -0.06em;
        text-transform: uppercase;
      }

      .lead {
        margin-top: 32px;
        max-width: 780px;
        font-size: clamp(22px, 3vw, 34px);
        line-height: 1.16;
        color: var(--text);
      }

      .press-cta,
      .download-epk {
        margin-top: 48px;
        border: 1px solid var(--line);
        border-radius: 28px;
        background:
          linear-gradient(135deg, rgba(216, 255, 62, 0.1), transparent),
          rgba(16, 20, 27, 0.72);
        padding: 30px;
        backdrop-filter: blur(12px);
      }

      .press-cta {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 28px;
        align-items: center;
      }

      .press-cta p,
      .download-epk p {
        margin: 0;
        max-width: 720px;
        color: var(--muted);
        font-size: 17px;
        line-height: 1.7;
      }

      .press-cta strong,
      .download-epk strong {
        color: var(--text);
      }

      .download-epk {
        display: block;
      }

      .download-epk h2 {
        margin: 0 0 20px;
        color: var(--acid);
        font-size: 13px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .download-title {
        margin: 0 0 18px;
        font-size: clamp(34px, 5vw, 58px);
        line-height: 0.95;
        letter-spacing: -0.06em;
        text-transform: uppercase;
      }

      .download-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
      }

      .cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: flex-end;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--text);
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        white-space: nowrap;
        cursor: pointer;
        transition:
          transform 0.2s ease,
          background 0.2s ease,
          border-color 0.2s ease,
          color 0.2s ease;
      }

      .button.primary {
        background: var(--acid);
        color: #050608;
        border-color: var(--acid);
      }

      .button:hover {
        transform: translateY(-2px);
        border-color: var(--acid);
      }

      .kit-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 28px;
        margin-top: 72px;
      }

      .panel {
        border: 1px solid var(--line);
        background: rgba(16, 20, 27, 0.72);
        border-radius: 28px;
        padding: 28px;
        backdrop-filter: blur(12px);
      }

      .panel.wide {
        grid-column: span 2;
      }

      .panel h2 {
        margin: 0 0 20px;
        color: var(--acid);
        font-size: 13px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .panel p {
        color: var(--muted);
        font-size: 17px;
        line-height: 1.7;
        margin: 0 0 20px;
      }

      .panel strong {
        color: var(--text);
      }

      .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 22px;
      }

      .tag {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 9px 13px;
        color: var(--muted);
        font-size: 13px;
      }

      .link-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        border-top: 1px solid var(--line);
        padding: 18px 0;
        color: var(--muted);
      }

      .link-row strong {
        color: var(--text);
        font-size: 20px;
      }

      .link-row span {
        color: var(--acid);
        text-transform: uppercase;
        letter-spacing: 0.16em;
        font-size: 12px;
      }

      .link-row:hover strong {
        color: var(--acid);
      }

      .facts {
        display: grid;
        gap: 16px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .facts li {
        border-top: 1px solid var(--line);
        padding-top: 16px;
        color: var(--muted);
        line-height: 1.5;
      }

      .facts strong {
        display: block;
        color: var(--text);
        margin-bottom: 4px;
      }

      .asset-list {
        display: grid;
        gap: 14px;
        margin: 20px 0 0;
        padding: 0;
        list-style: none;
      }

      .asset-list li {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        border-top: 1px solid var(--line);
        padding-top: 14px;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.5;
      }

      .asset-list strong {
        color: var(--text);
      }

      .asset-list span {
        color: var(--acid);
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 11px;
        white-space: nowrap;
      }

      .note {
        margin-top: 20px;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.6;
      }

      .epk-modal {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 28px;
        background: rgba(0, 0, 0, 0.72);
        backdrop-filter: blur(12px);
      }

      .epk-modal.is-open {
        display: flex;
      }

      .epk-modal-content {
        position: relative;
        width: min(760px, 96vw);
        max-height: 92vh;
        overflow-y: auto;
        border: 1px solid rgba(216, 255, 62, 0.18);
        border-radius: 32px;
        background:
          radial-gradient(circle at top right, rgba(216, 255, 62, 0.14), transparent 34%),
          rgba(7, 9, 12, 0.96);
        padding: clamp(24px, 5vw, 42px);
        box-shadow: 0 24px 90px rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(16px);
      }

      .epk-modal-label {
        margin: 0 0 16px;
        color: var(--acid);
        text-transform: uppercase;
        letter-spacing: 0.22em;
        font-size: 12px;
      }

      .epk-modal-title {
        margin: 0;
        font-size: clamp(36px, 6vw, 68px);
        line-height: 0.92;
        letter-spacing: -0.06em;
        text-transform: uppercase;
      }

      .epk-modal-copy {
        margin: 22px 0 0;
        color: rgba(244, 244, 240, 0.76);
        font-size: 17px;
        line-height: 1.7;
        max-width: 620px;
      }

      .epk-modal-form {
        margin-top: 28px;
        border: 1px solid rgba(216, 255, 62, 0.22);
        border-radius: 24px;
        background: #ffffff;
        padding: 22px;
        overflow: hidden;
      }

      .epk-modal-form iframe {
        width: 100%;
        background: #ffffff;
        border: 0;
      }

      .epk-download-confirmation {
        display: none;
        margin-top: 22px;
        padding: 22px;
        border: 1px solid rgba(216, 255, 62, 0.24);
        border-radius: 22px;
        background: rgba(216, 255, 62, 0.08);
      }

      .epk-download-confirmation.is-visible {
        display: block;
      }

      .epk-download-confirmation p {
        margin: 0 0 18px;
        color: rgba(244, 244, 240, 0.82);
        font-size: 15px;
        line-height: 1.6;
      }

      .epk-modal-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
      }

      .epk-modal-actions-secondary {
        justify-content: flex-start;
      }

      .epk-modal-close {
        position: absolute;
        top: 18px;
        right: 18px;
        width: 42px;
        height: 42px;
        border: 1px solid rgba(244, 244, 240, 0.14);
        border-radius: 999px;
        background: rgba(16, 20, 27, 0.9);
        color: var(--acid);
        cursor: pointer;
        font-size: 22px;
        line-height: 1;
      }

      .epk-modal-close:hover {
        border-color: var(--acid);
      }

      footer {
        max-width: 1080px;
        margin: 80px auto 0;
        color: var(--muted);
        font-size: 12px;
        padding-top: 28px;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        gap: 20px;
      }

      footer a {
        color: var(--muted);
      }

      footer a:hover {
        color: var(--acid);
      }

      @media (max-width: 1024px) {
        .page {
          padding: 22px;
        }

        .button {
          width: 100%;
        }

        footer {
          flex-direction: column;
        }
      }

      @media (max-width: 900px) {
        .press-cta {
          grid-template-columns: 1fr;
        }

        .cta-actions {
          justify-content: flex-start;
        }
      }

      @media (max-width: 860px) {
        .kit-grid {
          grid-template-columns: 1fr;
          margin-top: 48px;
        }

        .panel.wide {
          grid-column: span 1;
        }

        .link-row,
        .asset-list li {
          align-items: flex-start;
          flex-direction: column;
          gap: 8px;
        }

        .epk-modal {
          padding: 16px;
        }

        .epk-modal-content {
          border-radius: 24px;
        }

        .epk-modal-actions {
          flex-direction: column;
        }
      }
      /* Online EPK preview — scoped editorial layouts */
      .epk-assets-access { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; margin-top:28px; }
      .epk-assets-access article { border:1px solid var(--line); border-radius:22px; padding:28px; background:rgba(16,20,27,.72); }
      .epk-assets-access h3 { font-size:clamp(24px,3vw,32px); line-height:1.1; margin:20px 0 10px; letter-spacing:-.04em; }
      .epk-assets-access p { font-size:15px; color:var(--muted); line-height:1.65; }
      @media(max-width:700px) { .epk-assets-access { grid-template-columns:1fr; } }
      html { scroll-behavior: smooth; }
      .epk-hero { display: grid; grid-template-columns: minmax(0,1.08fr) minmax(0,.92fr); gap: clamp(24px,4vw,60px); min-height: 540px; align-items: stretch; }
      .epk-hero-copy { display:flex; flex-direction:column; justify-content:center; padding: 24px 0; }
      .epk-hero h1 { font-size: clamp(68px,9vw,124px); letter-spacing:-.075em; line-height:.84; }
      .acid-dot { color:var(--acid); }
      .epk-kicker { color:var(--acid); text-transform:uppercase; font-weight:700; letter-spacing:.2em; font-size:13px; margin:28px 0 0; }
      .epk-hero-lead { color:var(--text); font-size:clamp(24px,3vw,37px); line-height:1.18; letter-spacing:-.03em; margin:22px 0 0; max-width:600px; }
      .epk-hero-detail { color:var(--muted); font-size:15px; line-height:1.65; margin:18px 0 0; max-width:500px; }
      .epk-actions { display:flex; gap:12px; flex-wrap:wrap; margin-top:28px; }
      .epk-quick-links { display:flex; flex-wrap:wrap; gap:12px 20px; padding-top:24px; margin-top:34px; border-top:1px solid var(--line); }
      .epk-quick-links a { font-size:12px; color:var(--muted); text-transform:uppercase; letter-spacing:.07em; }
      .epk-quick-links a:hover { color:var(--acid); }
      .epk-hero-photo { position:relative; overflow:hidden; min-height:450px; border:1px solid rgba(216,255,62,.28); border-radius:24px; background:#10141b; }
      .epk-hero-photo img { display:block; width:100%; height:100%; position:absolute; inset:0; object-fit:cover; object-position: 50% 45%; transform:scale(1.38); transform-origin:50% 45%; }
      .epk-hero-photo::after { content:""; position:absolute; inset:45% 0 0; pointer-events:none; background:linear-gradient(transparent,rgba(0,0,0,.72)); }
      .photo-mark { position:absolute; z-index:1; bottom:24px; left:24px; right:16px; display:flex; flex-direction:column; align-items:flex-start; gap:6px; line-height:1.3; text-transform:uppercase; text-shadow:0 1px 12px rgba(0,0,0,.75); }
      .photo-mark strong { color:var(--text); font-size:clamp(20px,2.2vw,25px); font-weight:800; letter-spacing:.12em; }
      .photo-mark span:nth-child(2) { color:#c6c9c8; font-size:13px; font-weight:600; letter-spacing:.11em; }
      .photo-mark span:nth-child(3) { color:var(--acid); font-size:9px; font-weight:700; letter-spacing:.27em; }
      .epk-section { margin-top:100px; scroll-margin-top:28px; }
      .epk-section-head .eyebrow { margin-bottom:12px; }
      .epk-section-head h2,.epk-contact h2,.epk-download-section h2 { margin:0; color:var(--text); font-size:clamp(36px,5vw,62px); line-height:1; letter-spacing:-.055em; }
      .epk-section-intro { max-width:850px; color:var(--muted); font-size:clamp(18px,2.2vw,24px); line-height:1.5; margin:22px 0 32px; }
      .epk-credentials { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin:28px 0 18px; }
      .epk-credentials article { border:1px solid var(--line); border-radius:20px; padding:24px; background:rgba(16,20,27,.72); }
      .epk-number { display:block; font-size:11px; color:var(--acid); letter-spacing:.12em; text-transform:uppercase; font-weight:700; }
      .epk-credentials h3 { margin:24px 0 8px; font-size:clamp(20px,2.5vw,28px); line-height:1.05; letter-spacing:-.035em; }
      .epk-credentials p { color:var(--muted); margin:0; font-size:14px; }
      .epk-text-link { display:inline-flex; gap:10px; margin-top:18px; padding-bottom:7px; color:var(--acid); border-bottom:1px solid rgba(216,255,62,.4); font-weight:700; font-size:12px; letter-spacing:.1em; text-transform:uppercase; }
      .epk-sound-grid { display:grid; grid-template-columns:1.25fr .75fr; gap:18px; margin-top:28px; }
      .epk-featured-track { display:flex; gap:22px; padding:24px; border:1px solid rgba(216,255,62,.25); border-radius:24px; background:linear-gradient(135deg,rgba(216,255,62,.08),transparent),#10141b; align-items:center; }
      .epk-featured-art { width:42%; flex-shrink:0; aspect-ratio:1; overflow:hidden; border-radius:14px; background:#090d11; }
      .epk-featured-art img { display:block; width:100%; height:100%; object-fit:contain; object-position:center; transform:none; }
      .epk-featured-track h3 { font-size:clamp(26px,3vw,38px); margin:10px 0; line-height:1; letter-spacing:-.04em; }
      .epk-featured-track p { color:var(--muted); font-size:14px; line-height:1.6; }
      .epk-featured-track .button { margin-top:12px; }
      .epk-track-list { padding:24px; border:1px solid var(--line); border-radius:24px; background:rgba(16,20,27,.72); }
      .epk-track { display:flex; gap:12px; align-items:center; padding:14px 0; border-bottom:1px solid var(--line); }
      .epk-track img { flex:0 0 56px; width:56px; height:56px; object-fit:cover; border-radius:8px; }
      .epk-track span:nth-child(2) { flex:1; min-width:0; }
      .epk-track strong,.epk-track small { display:block; }
      .epk-track strong { font-size:17px; } .epk-track small { color:var(--muted); margin-top:4px; }
      .epk-track > span:last-child { color:var(--acid); }
      .epk-set-panel { display:flex; align-items:center; justify-content:space-between; gap:22px; margin-top:18px; padding:28px; border-radius:24px; border:1px solid var(--line); background:rgba(16,20,27,.72); }
      .epk-set-panel h3 { font-size:30px; letter-spacing:-.04em; margin:12px 0; }
      .epk-set-panel p { max-width:670px; margin:0; color:var(--muted); line-height:1.6; }
      .epk-photos { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; margin-top:28px; }
      .epk-photos a { display:flex; flex-direction:column; border:1px solid var(--line); background:#10141b; overflow:hidden; border-radius:20px; }
      .epk-photos img { display:block; width:100%; height:230px; object-fit:cover; transition:transform .25s ease; }
      .epk-photos a:hover img { transform:scale(1.025); }
      .epk-photos span { color:var(--acid); font-size:11px; text-transform:uppercase; letter-spacing:.1em; font-weight:700; padding:16px; }
      .epk-small-note { color:var(--muted); font-size:13px; line-height:1.6; margin:16px 0; }
      .epk-small-note a { text-decoration:underline; }
      .epk-download-section,.epk-contact { display:flex; justify-content:space-between; align-items:center; gap:32px; padding:clamp(28px,4vw,46px); margin-top:90px; border:1px solid rgba(216,255,62,.25); border-radius:28px; background:linear-gradient(115deg,rgba(216,255,62,.12),transparent 55%),rgba(16,20,27,.85); scroll-margin-top:30px; }
      .epk-download-section p:not(.eyebrow),.epk-contact p:not(.eyebrow) { color:var(--muted); line-height:1.6; max-width:670px; }
      .epk-contact { margin-top:28px; border-color:var(--line); background:#10141b; }
      .epk-contact a[href^="mailto:"] { color:var(--acid); font-size:16px; overflow-wrap:anywhere; }
      .epk-contact .epk-actions { margin-top:0; }
      @media(max-width:900px) { .epk-hero { grid-template-columns:1fr; } .epk-hero-photo { min-height:460px; } .epk-sound-grid { grid-template-columns:1fr; } .epk-download-section,.epk-contact,.epk-set-panel { flex-direction:column; align-items:stretch; } }
      @media(max-width:600px) { .epk-section { margin-top:64px; } .epk-hero-photo { min-height:350px; } .epk-credentials,.epk-photos { grid-template-columns:1fr; } .epk-photos img { height:260px; } .epk-featured-track { flex-direction:column; align-items:stretch; } .epk-featured-art { width:100%; max-height:310px; } .epk-quick-links { gap:12px 16px; } .epk-hero h1 { font-size:clamp(58px,15vw,90px); } }
    </style>
  </head>

  <body>
    <div class="page">
      <SiteHeader activePage="press-kit" />

      <main>
        <section class="epk-hero" aria-labelledby="epk-title">
          <div class="epk-hero-copy">
            <p class="eyebrow">Official electronic press kit · Portugal</p>
            <h1 id="epk-title">Itchy<br />Lemon<span class="acid-dot">.</span></h1>
            <p class="epk-kicker">DJ &amp; Producer</p>
            <p class="epk-hero-lead">Deep grooves, melodic tension and an instinct for the dancefloor.</p>
            <p class="epk-hero-detail">A concise introduction for promoters, venues, festivals, radio and music media. Everything essential, in one place.</p>
            <div class="epk-actions">
              <a class="button primary" href="#listen">Listen to the sound</a>
              <a class="button" href="mailto:itchylemon.booking@gmail.com?subject=Itchy%20Lemon%20-%20Booking%20Enquiry">Booking enquiry</a>
            </div>
            <div class="epk-quick-links" aria-label="Jump to EPK sections">
              <a href="#highlights">Highlights</a><a href="#listen">Music &amp; sets</a><a href="#assets">Press photos</a><a href="#full-epk">Download PDF</a>
            </div>
          </div>
          <div class="epk-hero-photo">
            <img src="/media/itchy-lemon-epk-portrait.png" alt="Itchy Lemon — artist portrait" loading="eager" decoding="async" />
            <span class="photo-mark"><strong>ITCHY LEMON</strong><span>Electronic Music Artist</span><span>Melodic · Deep · Groovy</span></span>
          </div>
        </section>

        <section id="highlights" class="epk-section" aria-labelledby="highlights-title">
          <div class="epk-section-head"><p class="eyebrow">Selected credentials</p><h2 id="highlights-title">Behind the sound.</h2></div>
          <p class="epk-section-intro">Itchy Lemon is a Portuguese DJ and electronic music producer with a current focus on melodic, deep and groove-driven electronic music. The project combines recent club and radio activity with an artistic path that includes selected appearances in London and Portugal.</p>
          <div class="epk-credentials">
            <article><span class="epk-number">01 / Porto · 2026</span><h3>Calico</h3><p>Resident DJ · since August 2026</p></article>
            <article><span class="epk-number">02 / Radio · 2026</span><h3>Ibiza Stardust Radio</h3><p>Resident DJ · since October 2026</p></article>
            <article><span class="epk-number">03 / Radio · 2026</span><h3>Pinnacle Nexus Radio</h3><p>World Groove · tracks in rotation</p></article>
