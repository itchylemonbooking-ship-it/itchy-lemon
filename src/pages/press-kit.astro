    <MetaPixel />
    <GlobalMixcloudPlayer />
    <HubSpotTracking />

    <script src="https://js-eu1.hsforms.net/forms/embed/148590426.js" defer></script>

    <script>
      const epkFormId = "c48c62f5-f0b6-4153-8aaa-b4f9f4b952ab";

      const epkModal = document.querySelector("[data-epk-modal]");
      const epkModalTriggers = document.querySelectorAll(
        "[data-open-epk-modal]"
      );
      const epkModalClose = document.querySelector(
        "[data-close-epk-modal]"
      );
      const epkDownloadConfirmation = document.querySelector(
        "[data-epk-download-confirmation]"
      );
      const epkDownloadButton = document.querySelector(
        "[data-download-epk-file]"
      );

      // Only accept legacy HubSpot callbacks from trusted origins.
      const isTrustedHubSpotOrigin = (origin) => {
        if (origin === window.location.origin) {
          return true;
        }

        try {
          const url = new URL(origin);
          const trustedDomains = [
            "hsforms.com",
            "hsforms.net",
            "hubspot.com",
            "hs-sites.com",
          ];

          return (
            url.protocol === "https:" &&
            trustedDomains.some(
              (domain) =>
                url.hostname === domain ||
                url.hostname.endsWith(`.${domain}`)
            )
          );
        } catch {
          return false;
        }
      };

      const hasMetaConsent = () => {
        try {
          return localStorage.getItem("itchyLemonMetaConsent") === "granted";
        } catch {
          return false;
        }
      };

      let epkIntentTracked = false;
      let epkLeadTracked = false;
      let epkDownloadTracked = false;

      const trackEpkIntent = (trigger) => {
        if (
          epkIntentTracked ||
          !hasMetaConsent() || typeof window.fbq !== "function"
        ) {
          return;
        }

        const triggerLabel =
          trigger?.textContent?.trim().replace(/\s+/g, " ") ||
          "Download EPK";

        window.fbq("trackCustom", "EPKIntent", {
          source_page: "press-kit",
          trigger_label: triggerLabel,
          form_id: epkFormId,
        });

        epkIntentTracked = true;
      };

      const trackEpkLead = () => {
        if (
          epkLeadTracked ||
          !hasMetaConsent() || typeof window.fbq !== "function"
        ) {
          return;
        }

        window.fbq("track", "Lead", {
          content_name: "EPK Request",
          content_category: "Press Kit",
          source_page: "press-kit",
          form_id: epkFormId,
        });

        epkLeadTracked = true;
      };

      const trackEpkDownload = () => {
        if (
          epkDownloadTracked ||
          !hasMetaConsent() || typeof window.fbq !== "function"
        ) {
          return;
        }

        window.fbq("trackCustom", "EPKDownload", {
          content_name: "Itchy Lemon EPK 2026",
          source_page: "press-kit",
          file_name: "Itchy_Lemon_EPK_2026.pdf",
        });

        epkDownloadTracked = true;
      };

      const handleSuccessfulEpkSubmission = () => {
        epkDownloadConfirmation?.classList.add("is-visible");
        trackEpkLead();
      };

      const openEpkModal = (trigger) => {
        epkModal.classList.add("is-open");
        epkModal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";

        trackEpkIntent(trigger);
      };

      const closeEpkModal = () => {
        epkModal.classList.remove("is-open");
        epkModal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      };

      epkModalTriggers.forEach((trigger) => {
        trigger.addEventListener("click", (event) => {
          event.preventDefault();
          openEpkModal(trigger);
        });
      });

      epkModalClose?.addEventListener("click", closeEpkModal);

      epkModal?.addEventListener("click", (event) => {
        if (event.target === epkModal) {
          closeEpkModal();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          epkModal.classList.contains("is-open")
        ) {
          closeEpkModal();
        }
      });

      window.addEventListener(
        "hs-form-event:on-submission:success",
        (event) => {
          const submittedFormId = event.detail?.formId || "";

          if (submittedFormId !== epkFormId) {
            return;
          }

          handleSuccessfulEpkSubmission();
        }
      );

      window.addEventListener("message", (event) => {
        if (!isTrustedHubSpotOrigin(event.origin)) {
          return;
        }

        if (
          !event.data ||
          event.data.type !== "hsFormCallback" ||
          event.data.eventName !== "onFormSubmitted"
        ) {
          return;
        }

        const submittedFormId =
          event.data.id ||
          event.data.formId ||
          "";

        if (submittedFormId !== epkFormId) {
          return;
        }

        handleSuccessfulEpkSubmission();
      });

      epkDownloadButton?.addEventListener("click", (event) => {
        event.preventDefault();

        const downloadUrl = epkDownloadButton.getAttribute("href");
        const downloadName =
          epkDownloadButton.getAttribute("download") ||
          "Itchy_Lemon_EPK_2026.pdf";

        trackEpkDownload();

        setTimeout(() => {
          if (downloadUrl) {
            const downloadLink = document.createElement("a");

            downloadLink.href = downloadUrl;
            downloadLink.download = downloadName;
            downloadLink.style.display = "none";

            document.body.appendChild(downloadLink);
            downloadLink.click();
            downloadLink.remove();
          }

          closeEpkModal();
        }, 700);
      });
    </script>
  </body>
</html>