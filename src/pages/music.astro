---
import SiteHeader from "../components/SiteHeader.astro";
import GlobalMixcloudPlayer from "../components/GlobalMixcloudPlayer.astro";
import HubSpotTracking from "../components/HubSpotTracking.astro";
import MetaPixel from "../components/MetaPixel.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Music by Itchy Lemon — original productions, releases, remixes and official links on Spotify, Apple Music, Beatport, Traxsource, SoundCloud and YouTube."
    />
    <meta name="author" content="Itchy Lemon" />
    <meta name="theme-color" content="#07090c" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Music | Itchy Lemon</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://itchylemon.com/music/" />

    <style>
      :root {
        --bg: #07090c;
        --bg-soft: #10141b;
        --text: #f4f4f0;
        --muted: #a7adb8;
        --acid: #d8ff3e;
        --line: rgba(255, 255, 255, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background:
          radial-gradient(circle at top right, rgba(216, 255, 62, 0.12), transparent 34%),
          linear-gradient(135deg, #07090c 0%, #111827 48%, #050608 100%);
        color: var(--text);
        min-height: 100vh;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        font: inherit;
      }

      .page {
        min-height: 100vh;
        padding: 32px;
      }

      main {
        max-width: 1080px;
        margin: 0 auto;
      }

      .eyebrow {
        color: var(--acid);
        text-transform: uppercase;
        letter-spacing: 0.24em;
        font-size: 13px;
        margin-bottom: 18px;
      }

      h1 {
        margin: 0;
        font-size: clamp(48px, 8vw, 104px);
        line-height: 0.9;
        letter-spacing: -0.06em;
        text-transform: uppercase;
        color: var(--text);
      }

      .lead {
        margin-top: 32px;
        max-width: 780px;
        font-size: clamp(22px, 3vw, 34px);
        line-height: 1.16;
        color: var(--acid);
      }

      .release-feature {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 28px;
        align-items: stretch;
        margin-top: 62px;
        padding: 28px;
        border-radius: 28px;
        border: 1px solid rgba(216, 255, 62, 0.25);
        background:
          linear-gradient(135deg, rgba(216, 255, 62, 0.12), transparent 52%),
          rgba(16, 20, 27, 0.8);
        backdrop-filter: blur(12px);
      }

      .featured-copy {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        padding: clamp(4px, 2vw, 24px);
      }

      .featured-copy h2 {
        margin: 14px 0 18px;
        font-size: clamp(44px, 6vw, 78px);
        line-height: 0.95;
        letter-spacing: -0.055em;
      }

      .featured-copy > p:not(.section-label):not(.external-note) {
        margin: 0;
        max-width: 500px;
        color: var(--muted);
        line-height: 1.7;
        font-size: 16px;
      }

      .release-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 28px;
      }

      .external-note {
        margin: 16px 0 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.5;
      }

      .featured-art {
        position: relative;
        aspect-ratio: 1;
        min-height: 350px;
        overflow: hidden;
        border: 1px solid rgba(216, 255, 62, 0.22);
        border-radius: 20px;
        background: #090d11;
      }

      .featured-art img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }

      .selected-music {
        margin-top: 72px;
      }

      .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 24px;
      }

      .section-heading h2 {
        margin: 0;
        font-size: clamp(30px, 4vw, 44px);
        letter-spacing: -0.05em;
      }

      .section-heading > a {
        padding-bottom: 6px;
        color: var(--acid);
        border-bottom: 1px solid rgba(216, 255, 62, 0.4);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .section-heading > a:hover {
        border-bottom-color: var(--acid);
      }

      .music-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
      }

      .track-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 24px;
        min-height: 205px;
        padding: 24px;
        border: 1px solid var(--line);
        border-radius: 24px;
        background: rgba(16, 20, 27, 0.72);
        transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
      }

      .track-card:hover,
      .track-card:focus-visible {
        transform: translateY(-3px);
        background: rgba(216, 255, 62, 0.07);
        border-color: rgba(216, 255, 62, 0.65);
      }

      .track-no {
        color: var(--acid);
        font-size: 12px;
        letter-spacing: 0.14em;
      }

      .track-name {
        display: block;
        margin-top: auto;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.045em;
      }

      .track-year {
        color: var(--muted);
        font-size: 13px;
      }

      .track-action {
        display: flex;
        justify-content: space-between;
        width: 100%;
        padding-top: 14px;
        border-top: 1px solid var(--line);
        color: var(--acid);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-weight: 700;
      }

      .music-cta {
        margin-top: 48px;
        border: 1px solid var(--line);
        border-radius: 28px;
        background:
          linear-gradient(135deg, rgba(216, 255, 62, 0.1), transparent),
          rgba(16, 20, 27, 0.72);
        padding: 30px;
        backdrop-filter: blur(12px);
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 28px;
        align-items: center;
      }

      .music-cta p {
        margin: 0;
        max-width: 720px;
        color: var(--muted);
        font-size: 17px;
        line-height: 1.7;
      }

      .music-cta strong {
        color: var(--text);
      }

      .cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: flex-end;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 999px;
        border: 1px solid var(--line);
        color: var(--text);
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        white-space: nowrap;
        transition:
          transform 0.2s ease,
          background 0.2s ease,
          border-color 0.2s ease;
      }

      .button.primary {
        background: var(--acid);
        color: #050608;
        border-color: var(--acid);
      }

      .button:hover {
        transform: translateY(-2px);
        border-color: var(--acid);
      }

      .link-list {
        display: grid;
        gap: 14px;
        margin-top: 56px;
      }

      .section-label {
        color: var(--acid);
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 13px;
        margin: 0 0 8px;
      }

      .music-link {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        align-items: center;
        border-top: 1px solid var(--line);
        padding: 20px 0;
        color: var(--muted);
      }

      .music-link strong {
        color: var(--text);
        font-size: 20px;
      }

      .music-link span {
        color: var(--acid);
        text-transform: uppercase;
        letter-spacing: 0.16em;
        font-size: 12px;
      }

      .music-link:hover strong {
        color: var(--acid);
      }

      footer {
        max-width: 1080px;
        margin: 80px auto 0;
        color: var(--muted);
        font-size: 12px;
        padding-top: 28px;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        gap: 20px;
      }

      footer a {
        color: var(--muted);
      }

      footer a:hover {
        color: var(--acid);
      }

      @media (max-width: 1024px) {
        .page {
          padding: 22px;
        }

        .music-link {
          align-items: flex-start;
          flex-direction: column;
          gap: 8px;
        }

        .button {
          width: 100%;
        }

        footer {
          flex-direction: column;
        }
      }

      @media (max-width: 600px) {
        .release-feature {
          padding: 16px;
          margin-top: 44px;
        }

        .featured-art {
          min-height: 0;
        }

        .release-actions {
          width: 100%;
        }

        .release-actions .button {
          width: 100%;
        }

        .track-card {
          min-height: 185px;
        }
      }

      @media (max-width: 900px) {
        .release-feature,
        .music-grid,
        .music-cta {
          grid-template-columns: 1fr;
        }

        .featured-art {
          min-height: 0;
        }

        .cta-actions {
          justify-content: flex-start;
        }
      }
    </style>
  </head>

  <body>
    <div class="page">
      <SiteHeader activePage="music" />

      <main>
        <p class="eyebrow">Original productions · Selected releases</p>

        <h1>Music</h1>

        <p class="lead">
          Groove, atmosphere and emotional progression. Discover the original music of Itchy Lemon.
        </p>

        <section class="release-feature" aria-labelledby="featured-release-title">
          <div class="featured-copy">
            <p class="section-label">Featured original · 2026</p>
            <h2 id="featured-release-title">In My Veins</h2>
            <p>
              A darker, melodic production built around a deep groove, spoken vocals and slow-burning tension.
            </p>
            <div class="release-actions">
              <a class="button primary" href="https://open.spotify.com/track/029gRb7QR6Cg1TM2YkroDK" target="_blank" rel="noopener noreferrer">
                Listen to the Track
              </a>
            </div>
            <p class="external-note">Listen directly on Spotify.</p>
          </div>
          <div class="featured-art">
            <img
              src="/media/in-my-veins-cover.webp"
              alt="Capa do lançamento In My Veins — Itchy Lemon"
              width="800"
              height="800"
              loading="eager"
              decoding="async"
            />
          </div>
        </section>

        <section class="selected-music" aria-labelledby="selected-releases-title">
          <div class="section-heading">
            <div>
              <p class="section-label">Explore the sound</p>
              <h2 id="selected-releases-title">Selected releases</h2>
            </div>
            <a href="/discography">View Discography <span aria-hidden="true">↗</span></a>
          </div>
          <div class="music-grid">
            <a class="track-card" href="https://open.spotify.com/track/2HBqKVXN4kkwiRzVGPOAyN" target="_blank" rel="noopener noreferrer">
              <span class="track-no">01 / Original release</span>
              <strong class="track-name">Wide Open</strong>
              <span class="track-year">Itchy Lemon · 2026</span>
              <span class="track-action">Listen on Spotify <span aria-hidden="true">↗</span></span>
            </a>
            <a class="track-card" href="https://open.spotify.com/track/2sQmYmr3hwOvRKE72Xf9iK" target="_blank" rel="noopener noreferrer">
              <span class="track-no">02 / Original release</span>
              <strong class="track-name">Blasted</strong>
              <span class="track-year">Itchy Lemon · 2026</span>
              <span class="track-action">Listen on Spotify <span aria-hidden="true">↗</span></span>
            </a>
            <a class="track-card" href="https://open.spotify.com/track/0j8uHrkVFCDasMD0LwkL5n" target="_blank" rel="noopener noreferrer">
              <span class="track-no">03 / Original release</span>
              <strong class="track-name">Amsterdam</strong>
              <span class="track-year">Itchy Lemon · 2026</span>
              <span class="track-action">Listen on Spotify <span aria-hidden="true">↗</span></span>
            </a>
          </div>
        </section>

        <section class="music-cta" aria-label="DJ sets and booking">
          <p>
            Looking for <strong>DJ sets or booking information?</strong> Listen to selected sets or get in touch.
          </p>

          <div class="cta-actions">
            <a class="button primary" href="/sets">Explore Sets</a>
            <a class="button" href="/booking">Request Booking</a>
          </div>
        </section>

        <section class="link-list" aria-label="Music platforms and official links">
          <p class="section-label">Official Music Links</p>

          <a class="music-link" href="https://open.spotify.com/artist/5IfFyzIiz1iBO7RZUJyFen" target="_blank" rel="noreferrer">
            <strong>Spotify</strong>
            <span>Listen</span>
          </a>

          <a class="music-link" href="https://itunes.apple.com/ph/artist/itchy-lemon/id656922930" target="_blank" rel="noreferrer">
            <strong>Apple Music / iTunes</strong>
            <span>Listen</span>
          </a>

          <a class="music-link" href="https://www.beatport.com/artist/itchy-lemon/339277" target="_blank" rel="noreferrer">
            <strong>Beatport</strong>
            <span>Artist page</span>
          </a>

          <a class="music-link" href="https://www.traxsource.com/artist/131494/itchy-lemon" target="_blank" rel="noreferrer">
            <strong>Traxsource</strong>
            <span>Artist page</span>
          </a>

          <a class="music-link" href="https://soundcloud.com/itchy-lemon" target="_blank" rel="noreferrer">
            <strong>SoundCloud</strong>
            <span>Listen</span>
          </a>

          <a class="music-link" href="https://www.youtube.com/@ItchyLemonTV" target="_blank" rel="noreferrer">
            <strong>YouTube</strong>
            <span>Watch</span>
          </a>

          <a class="music-link" href="/discography">
            <strong>Discography</strong>
            <span>View</span>
          </a>

          <a class="music-link" href="/press-kit">
            <strong>Press Kit</strong>
            <span>EPK</span>
          </a>
        </section>
      </main>

      <footer>
        <span>© 2026 Itchy Lemon. All rights reserved.</span>
        <span>
          Originals · Releases · Remixes · Music platforms · Booking ·
          <a href="/privacy-policy">Privacy Policy</a>
        </span>
      </footer>
    </div>

    <MetaPixel />
    <GlobalMixcloudPlayer />
    <HubSpotTracking />

  </body>
</html>