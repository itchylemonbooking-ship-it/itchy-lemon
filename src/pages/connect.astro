---
const pageTitle = "Itchy Lemon Connect";
const pageDescription =
  "Connect with Itchy Lemon — Melodic House & Techno DJ / Producer. Listen, press kit, booking and contact.";

const siteUrl = "https://itchylemon.com";
const heroImage = "/media/connect-hero.jpg";

const links = [
  {
    label: "Listen",
    description: "DJ sets, releases & latest music",
    href: "/sets",
    type: "internal",
    trackingName: "listen",
  },
  {
    label: "Press Kit / EPK",
    description: "Artist info, links & assets",
    href: "/press-kit",
    type: "internal",
    trackingName: "press_kit_epk",
  },
  {
    label: "Booking",
    description: "Events, DJ sets & collaborations",
    href: "/booking",
    type: "internal",
    trackingName: "booking",
  },
  {
    label: "Save Contact",
    description: "Add Itchy Lemon to your contacts",
    href: "/itchy-lemon-contact.vcf",
    type: "download",
    trackingName: "save_contact",
  },
  {
    label: "Instagram",
    description: "Follow the project",
    href: "https://www.instagram.com/itchy_lemon/",
    type: "external",
    trackingName: "instagram",
  },
  {
    label: "Email",
    description: "Direct contact",
    href: "mailto:alberto.vilela.digital@gmail.com",
    type: "external",
    trackingName: "email",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />

    <title>{pageTitle}</title>

    <link rel="canonical" href={`${siteUrl}/connect`} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}/connect`} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />

    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>

  <body>
    <main class="connect-page">
      <section class="connect-card" aria-labelledby="connect-title">
        <div class="visual-frame" aria-hidden="true">
          <img src={heroImage} alt="" loading="eager" decoding="async" />
        </div>

        <div class="content">
          <p class="eyebrow">Artist Connect</p>

          <h1 id="connect-title">Itchy Lemon</h1>

          <p class="claim">Melodic House &amp; Techno / DJ / Producer</p>

          <p class="intro">
            Melodic electronic music with deep groove, emotional tension and
            dancefloor instinct.
          </p>

          <nav class="link-list" aria-label="Itchy Lemon contact links">
            {
              links.map((link) => (
                <a
                  class="connect-link"
                  href={link.href}
                  target={link.type === "external" ? "_blank" : undefined}
                  rel={link.type === "external" ? "noopener noreferrer" : undefined}
                  download={link.type === "download" ? true : undefined}
                  data-track="connect_click"
                  data-track-name={link.trackingName}
                  data-track-label={link.label}
                  data-track-type={link.type}
                >
                  <span class="link-text">
                    <span class="link-label">{link.label}</span>
                    <span class="link-description">{link.description}</span>
                  </span>
                  <span class="link-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              ))
            }
          </nav>

          <p class="context-note">
            For bookings, collaborations, press or music-related contacts.
          </p>
        </div>

        <footer class="connect-footer">
          <span>Itchy Lemon · Porto, Portugal</span>
          <span>itchylemon.com/connect</span>
        </footer>
      </section>
    </main>

    <script>
      const campaignDefaults = {
        utm_source: "eletrico2026",
        utm_medium: "qr",
        utm_campaign: "connect_card",
      };

      const utmKeys = [
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_content",
        "utm_term",
      ];

      const currentUrl = new URL(window.location.href);
      const currentParams = currentUrl.searchParams;

      const getCampaignParams = () => {
        const params = new URLSearchParams();

        utmKeys.forEach((key) => {
          const value = currentParams.get(key);

          if (value) {
            params.set(key, value);
          }
        });

        if (!params.get("utm_source")) {
          params.set("utm_source", campaignDefaults.utm_source);
        }

        if (!params.get("utm_medium")) {
          params.set("utm_medium", campaignDefaults.utm_medium);
        }

        if (!params.get("utm_campaign")) {
          params.set("utm_campaign", campaignDefaults.utm_campaign);
        }

        return params;
      };

      const campaignParams = getCampaignParams();

      const getCampaignValue = (key) => {
        return campaignParams.get(key) || "";
      };

      const appendCampaignParamsToInternalLinks = () => {
        const trackedInternalLinks = document.querySelectorAll(
          'a[data-track][href^="/"]:not([href$=".vcf"])'
        );

        trackedInternalLinks.forEach((link) => {
          const href = link.getAttribute("href");

          if (!href) {
            return;
          }

          const linkUrl = new URL(href, window.location.origin);

          campaignParams.forEach((value, key) => {
            if (value && !linkUrl.searchParams.get(key)) {
              linkUrl.searchParams.set(key, value);
            }
          });

          link.setAttribute("href", `${linkUrl.pathname}${linkUrl.search}`);
        });
      };

      const trackConnectClick = (link) => {
        const eventName = "connect_click";

        const eventParams = {
          button_name: link.dataset.trackName || "",
          button_label: link.dataset.trackLabel || "",
          button_type: link.dataset.trackType || "",
          button_url: link.getAttribute("href") || "",
          source_page: "connect",
          utm_source: getCampaignValue("utm_source"),
          utm_medium: getCampaignValue("utm_medium"),
          utm_campaign: getCampaignValue("utm_campaign"),
        };

        if (typeof window.gtag === "function") {
          window.gtag("event", eventName, eventParams);
        }

        if (window._hsq && Array.isArray(window._hsq)) {
          window._hsq.push([
            "trackCustomBehavioralEvent",
            {
              name: "connect_click",
              properties: eventParams,
            },
          ]);
        }
      };

      const setupClickTracking = () => {
        const trackedLinks = document.querySelectorAll("a[data-track]");

        trackedLinks.forEach((link) => {
          link.addEventListener("click", () => {
            trackConnectClick(link);
          });
        });
      };

      appendCampaignParamsToInternalLinks();
      setupClickTracking();
    </script>
  </body>
</html>

<style>
  :root {
    --color-bg: #050605;
    --color-panel: rgba(12, 14, 12, 0.88);
    --color-text: #f3f5ef;
    --color-muted: rgba(243, 245, 239, 0.68);
    --color-soft: rgba(243, 245, 239, 0.44);
    --color-acid: #d8ff3e;
    --color-border: rgba(216, 255, 62, 0.18);
    --shadow-acid: 0 0 44px rgba(216, 255, 62, 0.2);
    --font-main:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    background: var(--color-bg);
  }

  body {
    min-height: 100vh;
    margin: 0;
    font-family: var(--font-main);
    color: var(--color-text);
    background:
      radial-gradient(circle at top left, rgba(216, 255, 62, 0.16), transparent 32rem),
      radial-gradient(circle at bottom right, rgba(95, 72, 255, 0.22), transparent 28rem),
      linear-gradient(135deg, #030403 0%, #080908 48%, #10120e 100%);
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    content: "";
    opacity: 0.08;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.18) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(circle at center, black 0%, transparent 78%);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .connect-page {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: 100vh;
    padding: 22px;
    place-items: center;
  }

  .connect-card {
    position: relative;
    width: min(100%, 460px);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 32px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent 22%),
      var(--color-panel);
    box-shadow:
      0 24px 90px rgba(0, 0, 0, 0.58),
      var(--shadow-acid);
    backdrop-filter: blur(18px);
  }

  .connect-card::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
    border-radius: inherit;
    background:
      linear-gradient(135deg, rgba(216, 255, 62, 0.1), transparent 24%),
      linear-gradient(315deg, rgba(255, 255, 255, 0.05), transparent 28%);
  }

  .visual-frame {
    position: relative;
    height: 188px;
    overflow: hidden;
    background: #060706;
  }

  .visual-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transform: scale(1.08);
  }

  .visual-frame::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 0.08) 48%,
        rgba(5, 6, 5, 0.82) 100%
      );
  }

  .content {
    position: relative;
    z-index: 2;
    padding: 28px 24px 18px;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--color-acid);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 12vw, 4.6rem);
    line-height: 0.9;
    letter-spacing: -0.08em;
    text-transform: uppercase;
  }

  .claim {
    margin: 16px 0 0;
    color: var(--color-text);
    font-size: 0.94rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .intro {
    max-width: 34ch;
    margin: 12px 0 24px;
    color: var(--color-muted);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .link-list {
    display: grid;
    gap: 10px;
  }

  .connect-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: 68px;
    padding: 14px 16px;
    border: 1px solid rgba(243, 245, 239, 0.1);
    border-radius: 18px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.08), transparent),
      rgba(255, 255, 255, 0.035);
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .connect-link:hover,
  .connect-link:focus-visible {
    border-color: rgba(216, 255, 62, 0.62);
    background:
      linear-gradient(135deg, rgba(216, 255, 62, 0.16), transparent),
      rgba(255, 255, 255, 0.055);
    box-shadow: 0 0 28px rgba(216, 255, 62, 0.12);
    outline: none;
    transform: translateY(-2px);
  }

  .link-text {
    display: grid;
    gap: 4px;
  }

  .link-label {
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: -0.01em;
  }

  .link-description {
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.3;
  }

  .link-arrow {
    display: grid;
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    place-items: center;
    color: #050605;
    font-size: 1rem;
    font-weight: 800;
    background: var(--color-acid);
  }

  .context-note {
    margin: 18px 0 0;
    color: var(--color-soft);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .connect-footer {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 4px;
    padding: 18px 24px 24px;
    color: rgba(243, 245, 239, 0.48);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 420px) {
    .connect-page {
      padding: 14px;
      align-items: start;
    }

    .connect-card {
      border-radius: 26px;
    }

    .visual-frame {
      height: 164px;
    }

    .content {
      padding: 24px 18px 16px;
    }

    .connect-link {
      min-height: 64px;
      padding: 13px 14px;
    }

    .connect-footer {
      padding: 16px 18px 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .connect-link {
      transition: none;
    }

    .connect-link:hover,
    .connect-link:focus-visible {
      transform: none;
    }
  }
</style>