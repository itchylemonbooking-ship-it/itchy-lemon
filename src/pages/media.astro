---
import SiteHeader from "../components/SiteHeader.astro";
import GlobalMixcloudPlayer from "../components/GlobalMixcloudPlayer.astro";
import HubSpotTracking from "../components/HubSpotTracking.astro";
import MetaPixel from "../components/MetaPixel.astro";
import archive from "../data/mediaArchive.json";

const { hero, galleries, videos } = archive;
const assetRoot = "/media/archive/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Media gallery for Itchy Lemon — live videos, artist photography, event flyers and press assets."
    />
    <meta name="author" content="Itchy Lemon" />
    <meta name="theme-color" content="#07090c" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Media | Itchy Lemon</title>

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://itchylemon.com/media/" />

    <style>
      :root {
        --bg: #07090c;
        --bg-soft: #10141b;
        --text: #f4f4f0;
        --muted: #a7adb8;
        --acid: #d8ff3e;
        --line: rgba(255, 255, 255, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background:
          radial-gradient(circle at top right, rgba(216, 255, 62, 0.12), transparent 34%),
          linear-gradient(135deg, #07090c 0%, #111827 48%, #050608 100%);
        color: var(--text);
        min-height: 100vh;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        font: inherit;
      }

      img {
        max-width: 100%;
      }

      .page {
        min-height: 100vh;
        padding: 32px;
      }

      main {
        max-width: 1080px;
        width: 100%;
        margin: 0 auto;
        padding-top: 12px;
      }

      .eyebrow {
        color: var(--acid);
        text-transform: uppercase;
        letter-spacing: 0.24em;
        font-size: 13px;
        margin: 0 0 18px;
      }

      h1 {
        margin: 0;
        font-size: clamp(48px, 8vw, 104px);
        line-height: 0.9;
        letter-spacing: -0.06em;
        text-transform: uppercase;
      }

      .lead {
        margin: 32px 0 0;
        max-width: 780px;
        font-size: clamp(22px, 3vw, 34px);
        line-height: 1.16;
        color: var(--text);
      }

      .hero-image {
        margin-top: 56px;
        border: 1px solid var(--line);
        border-radius: 28px;
        overflow: hidden;
        background:
          linear-gradient(135deg, rgba(216, 255, 62, 0.08), transparent),
          rgba(16, 20, 27, 0.72);
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.32);
      }

      .hero-trigger {
        display: block;
        width: 100%;
        padding: 0;
        border: 0;
        background: transparent;
        cursor: pointer;
      }

      .hero-image img {
        aspect-ratio: 960 / 503;
        object-fit: cover;
        display: block;
        width: 100%;
        height: auto;
        transition:
          transform 0.25s ease,
          opacity 0.25s ease;
      }

      .hero-trigger:hover img {
        transform: scale(1.02);
        opacity: 0.9;
      }

      .section-title {
        margin: 72px 0 22px;
        color: var(--acid);
        font-size: 13px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .carousel {
        margin-top: 22px;
      }

      .carousel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin: 72px 0 22px;
      }

      .carousel-header .section-title {
        margin: 0;
      }

      .carousel-controls {
        display: flex;
        gap: 10px;
      }

      .carousel-button {
        width: 44px;
        height: 44px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(16, 20, 27, 0.72);
        color: var(--acid);
        cursor: pointer;
        transition:
          border-color 0.2s ease,
          transform 0.2s ease,
          background 0.2s ease;
      }

      .carousel-button:hover {
        border-color: var(--acid);
        background: rgba(216, 255, 62, 0.08);
        transform: translateY(-1px);
      }

      .carousel-track {
        display: flex;
        gap: 18px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        padding: 2px 2px 16px;
        scrollbar-width: thin;
        scrollbar-color: rgba(216, 255, 62, 0.6) rgba(255, 255, 255, 0.08);
      }

      .carousel-track.is-expanded {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
      }

      @media (max-width: 600px) {
        .carousel-track.is-expanded {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 18px 12px;
        }
      }

      .gallery-toggle {
        margin-bottom: 16px;
        background: var(--bg-soft);
        cursor: pointer;
      }

      .carousel-track figure {
        flex: 0 0 min(320px, 82vw);
        min-width: 0;
        margin: 0;
        scroll-snap-align: start;
      }

      .gallery-item {
        display: block;
        width: 100%;
        aspect-ratio: 1 / 1;
        border: 1px solid var(--line);
        border-radius: 22px;
        overflow: hidden;
        background: rgba(16, 20, 27, 0.72);
        cursor: pointer;
        padding: 0;
      }

      .gallery-item img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition:
          transform 0.25s ease,
          opacity 0.25s ease;
      }

      .flyer-track .gallery-item img { object-fit: contain; background: #07090c; }
      .gallery-item:focus-visible, .carousel-button:focus-visible { outline: 2px solid var(--acid); outline-offset: 3px; }
      .gallery-item:hover img {
        transform: scale(1.04);
        opacity: 0.88;
      }

      .media-cta {
        margin-top: 64px;
        border: 1px solid var(--line);
        border-radius: 28px;
        background:
          linear-gradient(135deg, rgba(216, 255, 62, 0.1), transparent),
          rgba(16, 20, 27, 0.72);
        padding: 32px;
        backdrop-filter: blur(12px);
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 28px;
        align-items: center;
      }

      .media-cta p {
        margin: 0 0 14px;
        color: var(--acid);
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 12px;
      }

      .media-cta h2 {
        margin: 0;
        font-size: clamp(32px, 5vw, 56px);
        line-height: 0.95;
        letter-spacing: -0.06em;
        text-transform: uppercase;
      }

      .media-cta .cta-copy {
        margin-top: 18px;
        max-width: 680px;
        color: var(--muted);
        font-size: 17px;
        line-height: 1.7;
      }

      .cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: flex-end;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 999px;
        border: 1px solid var(--line);
        color: var(--text);
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        white-space: nowrap;
        transition:
          transform 0.2s ease,
          background 0.2s ease,
          border-color 0.2s ease;
      }

      .button.primary {
        background: var(--acid);
        color: #050608;
        border-color: var(--acid);
      }

      .button:hover {
        transform: translateY(-2px);
        border-color: var(--acid);
      }

      footer {
        max-width: 1080px;
        width: 100%;
        margin: 80px auto 0;
        color: var(--muted);
        font-size: 12px;
        padding-top: 28px;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        gap: 20px;
      }

      footer a {
        color: var(--muted);
      }

      footer a:hover {
        color: var(--acid);
      }

      .media-review {
        margin-top: 24px;
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 16px;
      }

      .media-review button { background: var(--bg-soft); cursor: pointer; }
      .media-review button:disabled { opacity: 0.55; cursor: default; }
      .media-review p { margin: 8px 0; }

      .media-review textarea {
        display: block;
        width: 100%;
        min-height: 8rem;
        padding: 10px;
        background: var(--bg);
        color: var(--text);
      }

      .media-review textarea[hidden] { display: none; }

      .media-review-check {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        margin-top: 4px;
        font-size: 0.875rem;
        cursor: pointer;
      }

      .media-review-check[hidden] { display: none; }
      .media-review-check input { width: 18px; height: 18px; margin: 0; accent-color: var(--acid); }
      .media-review-check:has(input:checked) { color: var(--acid); }

      figcaption {
        padding: 12px 2px 0;
        line-height: 1.45;
      }

      figcaption p {
        display: block;
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 0.875rem;
      }

      .video-track video {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 5;
        object-fit: contain;
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: 18px;
      }

      .media-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 32px;
      }

      .section-title[id] { scroll-margin-top: 90px; }

      .media-modal {
        width: min(1100px, calc(100% - 32px));
        max-height: 90dvh;
        border: 1px solid var(--line);
        border-radius: 22px;
        background: var(--bg);
        color: var(--text);
        padding: 14px;
      }

      .media-modal::backdrop { background: rgba(0, 0, 0, 0.85); }
      body:has(.media-modal[open]) { overflow: hidden; }

      .modal-image {
        display: block;
        width: 100%;
        max-height: 70dvh;
        object-fit: contain;
      }

      .modal-toolbar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 12px;
      }

      .modal-caption { flex: 1 1 10rem; margin: 0; }
      .modal-controls { display: flex; gap: 8px; margin-left: auto; }
      .carousel-button:disabled { opacity: 0.4; cursor: default; }
      .hero-trigger:focus-visible { outline: 2px solid var(--acid); outline-offset: -4px; }

      @media (prefers-reduced-motion: reduce) {
        html, .carousel-track { scroll-behavior: auto; }
        .hero-trigger img, .gallery-item img, .carousel-button, .button { transition: none; }
      }

      @media (max-width: 1024px) {
        .page {
          padding: 22px;
        }

        .cta-actions .button {
          width: 100%;
        }

        footer {
          flex-direction: column;
        }
      }

      @media (max-width: 900px) {
        .media-cta {
          grid-template-columns: 1fr;
        }

        .cta-actions {
          justify-content: flex-start;
        }
      }

      @media (max-width: 860px) {
        .hero-image {
          margin-top: 42px;
          border-radius: 20px;
        }

        .carousel-header {
          align-items: flex-start;
          flex-direction: column;
          gap: 14px;
        }

        .gallery-item {
          border-radius: 20px;
        }

        .media-cta {
          border-radius: 24px;
          padding: 18px;
        }

      }
    </style>
  </head>

  <body>
    <div class="page">
      <SiteHeader activePage="media" />

      <main>
        <p class="eyebrow">Gallery & Visual Archive</p>

        <h1>Media</h1>

        <p class="lead">
          Live footage, artist photography, event flyers and press images from the Itchy Lemon archive.
        </p>

        <nav class="media-nav" aria-label="Media sections">
          <a class="button" href="#videos">Videos</a>
          {galleries.map(({ id, title }) => <a class="button" href={`#${id}`}>{title}</a>)}
        </nav>

        <section id="media-review" class="media-review" lang="pt-PT" aria-label="Triagem do preview" hidden>
          <p>Marca as peças que queres retirar. A seleção fica neste navegador.</p>
          <p data-review-count role="status">0 peças marcadas</p>
          <button class="button" type="button" data-review-copy disabled>Copiar lista</button>
          <p data-review-message role="status"></p>
          <textarea data-review-list rows="6" aria-label="Lista de peças a retirar" readonly hidden></textarea>
        </section>

        <section class="hero-image" aria-label="Featured artist photograph">
          <button
            class="hero-trigger"
            type="button"
            data-full={`${assetRoot}${hero.slug}.webp`}
            data-title={hero.title}
            aria-label={`Enlarge ${hero.title}`}
          >
            <img
              src={`${assetRoot}${hero.slug}.webp`}
              srcset={`${assetRoot}${hero.slug}-thumb.webp 640w, ${assetRoot}${hero.slug}.webp ${hero.width}w`}
              sizes="(max-width: 1024px) calc(100vw - 44px), min(1080px, calc(100vw - 64px))"
              width={hero.width}
              height={hero.height}
              alt={hero.alt}
              fetchpriority="high"
            />
          </button>
        </section>

        <section class="carousel" data-carousel aria-labelledby="videos">
          <div class="carousel-header">
            <h2 class="section-title" id="videos">Videos</h2>
            <div class="carousel-controls">
              <button class="carousel-button" type="button" data-prev aria-controls="videos-track" aria-label="Previous videos" disabled>‹</button>
              <button class="carousel-button" type="button" data-next aria-controls="videos-track" aria-label="Next videos" disabled>›</button>
            </div>
          </div>
          <div class="carousel-track video-track" data-track id="videos-track">
            {videos.map(({ slug, title, description, width, height }) => (
              <figure>
                <video
                  controls
                  playsinline
                  preload="none"
                  poster={`${assetRoot}${slug}.webp`}
                  width={width}
                  height={height}
                  aria-labelledby={`${slug}-title`}
                  aria-describedby={`${slug}-description`}
                >
                  <source src={`${assetRoot}${slug}.mp4`} type="video/mp4" />
                  <a href={`${assetRoot}${slug}.mp4`}>Open video</a>
                </video>
                <figcaption>
                  <span id={`${slug}-title`}>{title}</span>
                  <label class="media-review-check" lang="pt-PT" hidden>
                      <input type="checkbox" data-review-item value={slug} data-review-title={title} aria-label={`Marcar para retirar: ${title}`} />
                      Marcar para retirar
                    </label>
                  <p id={`${slug}-description`}>{description}</p>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>

        {galleries.map(({ id, title, items }) => (
          <section class="carousel" data-carousel aria-labelledby={id}>
            <div class="carousel-header">
              <h2 class="section-title" id={id}>{title}</h2>
              <div class="carousel-controls">
                <button class="carousel-button" type="button" data-prev aria-controls={`${id}-track`} aria-label={`Previous strip of ${title.toLowerCase()}`} disabled>‹</button>
                <button class="carousel-button" type="button" data-next aria-controls={`${id}-track`} aria-label={`Next strip of ${title.toLowerCase()}`} disabled>›</button>
              </div>
            </div>

            {id === "flyers" && (
              <button class="button gallery-toggle" type="button" data-expand aria-expanded="false" aria-controls={`${id}-track`}>
                Show all {items.length} flyers
              </button>
            )}

            <div class:list={["carousel-track", { "flyer-track": id === "flyers" }]} data-track id={`${id}-track`}>
              {items.map(({ slug, title, alt, width, height }) => (
                <figure>
                  <button
                    class="gallery-item"
                    type="button"
                    data-full={`${assetRoot}${slug}.webp`}
                    data-title={title}
                    aria-label={`Enlarge ${title}`}
                  >
                    <img src={`${assetRoot}${slug}-thumb.webp`} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
                  </button>
                  <figcaption>
                    {title}
                    <label class="media-review-check" lang="pt-PT" hidden>
                      <input type="checkbox" data-review-item value={slug} data-review-title={title} aria-label={`Marcar para retirar: ${title}`} />
                      Marcar para retirar
                    </label>
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        ))}

        <section class="media-cta" aria-label="Press material and booking">
          <div>
            <p>Need press material?</p>
            <h2>Press & Booking</h2>
            <div class="cta-copy">
              Explore the official press kit or send a booking request for clubs, guest mixes, electronic music events and selected collaborations.
            </div>
          </div>

          <div class="cta-actions">
            <a class="button primary" href="/press-kit">
              Press Kit
            </a>

            <a class="button" href="/booking">
              Request Booking
            </a>
          </div>
        </section>

      </main>

      <footer>
        <span>© 2026 Itchy Lemon. All rights reserved.</span>
        <span>
          Videos · Photos · Flyers · Press ·
          <a href="/privacy-policy">Privacy Policy</a>
        </span>
      </footer>
    </div>

    <dialog class="media-modal" data-modal aria-label="Image preview">
      <img class="modal-image" data-modal-image alt="" />
      <div class="modal-toolbar">
        <p class="modal-caption" data-modal-caption aria-live="polite"></p>
        <div class="modal-controls">
          <button class="carousel-button" type="button" data-modal-prev aria-label="Previous image">‹</button>
          <button class="carousel-button" type="button" data-modal-next aria-label="Next image">›</button>
          <button class="carousel-button" type="button" data-modal-close aria-label="Close preview" autofocus>×</button>
        </div>
      </div>
    </dialog>

    <MetaPixel />
    <GlobalMixcloudPlayer />
    <HubSpotTracking />

    <script>
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      document.querySelectorAll("[data-carousel]").forEach((carousel) => {
        const track = carousel.querySelector<HTMLElement>("[data-track]")!;
        const previous = carousel.querySelector<HTMLButtonElement>("[data-prev]")!;
        const next = carousel.querySelector<HTMLButtonElement>("[data-next]")!;

        function updateControls() {
          previous.disabled = track.scrollLeft <= 1;
          next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
        }

        function scroll(direction: number) {
          track.scrollBy({
            left: direction * track.clientWidth * 0.85,
            behavior: reducedMotion.matches ? "instant" : "smooth",
          });
        }

        previous.addEventListener("click", () => scroll(-1));
        next.addEventListener("click", () => scroll(1));
        track.addEventListener("scroll", updateControls, { passive: true });
        new ResizeObserver(updateControls).observe(track);
        const expand = carousel.querySelector<HTMLButtonElement>("[data-expand]");
        expand?.addEventListener("click", () => {
          const expanded = track.classList.toggle("is-expanded");
          expand.setAttribute("aria-expanded", String(expanded));
          expand.textContent = expanded ? "Return to carousel" : `Show all ${track.children.length} flyers`;
          updateControls();
        });
        updateControls();
      });

      const dialog = document.querySelector<HTMLDialogElement>("[data-modal]")!;
      const image = dialog.querySelector<HTMLImageElement>("[data-modal-image]")!;
      const caption = dialog.querySelector<HTMLElement>("[data-modal-caption]")!;
      const close = dialog.querySelector<HTMLButtonElement>("[data-modal-close]")!;
      const previous = dialog.querySelector<HTMLButtonElement>("[data-modal-prev]")!;
      const next = dialog.querySelector<HTMLButtonElement>("[data-modal-next]")!;
      let opener: HTMLButtonElement;
      let items: HTMLButtonElement[] = [];
      let index = 0;

      function showImage() {
        const item = items[index];
        image.alt = item.querySelector("img")!.alt;
        image.src = item.dataset.full!;
        caption.textContent = item.dataset.title!;
      }

      function step(direction: number) {
        if (items.length < 2) return;
        index = (index + direction + items.length) % items.length;
        showImage();
      }

      document.querySelectorAll<HTMLButtonElement>("[data-full]").forEach((item) => {
        item.addEventListener("click", () => {
          opener = item;
          const track = item.closest("[data-track]");
          items = track ? [...track.querySelectorAll<HTMLButtonElement>("[data-full]")] : [item];
          index = items.indexOf(item);
          previous.hidden = next.hidden = items.length < 2;
          showImage();
          dialog.showModal();
        });
      });

      previous.addEventListener("click", () => step(-1));
      next.addEventListener("click", () => step(1));
      close.addEventListener("click", () => dialog.close());
      dialog.addEventListener("close", () => {
        image.removeAttribute("src");
        opener.focus();
      });
      dialog.addEventListener("click", (event) => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right ||
            event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
      });
      dialog.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") step(-1);
        if (event.key === "ArrowRight") step(1);
      });

      function enableMediaReview() {
        // Cloudflare previews use a branch alias or a deployment hash.
        const isPreview = /^(media-final-preview|[a-f0-9]{8})\.itchy-lemon\.pages\.dev$/.test(window.location.hostname);
        if (!isPreview) return;

        const panel = document.querySelector<HTMLElement>("#media-review")!;
        const count = panel.querySelector<HTMLElement>("[data-review-count]")!;
        const copy = panel.querySelector<HTMLButtonElement>("[data-review-copy]")!;
        const message = panel.querySelector<HTMLElement>("[data-review-message]")!;
        const list = panel.querySelector<HTMLTextAreaElement>("[data-review-list]")!;
        const items = [...document.querySelectorAll<HTMLInputElement>("[data-review-item]")];
        const key = "itchy-lemon:media-review";
        let selected: string[] = [];

        try {
          const saved = JSON.parse(localStorage.getItem(key) ?? "[]");
          if (Array.isArray(saved)) selected = saved;
        } catch {
          message.textContent = "A seleção pode não ficar guardada ao fechar a página.";
        }

        function updateSelection() {
          const marked = items.filter((item) => item.checked);
          count.textContent = marked.length === 1 ? "1 peça marcada" : `${marked.length} peças marcadas`;
          copy.disabled = marked.length === 0;
          list.value = marked.map((item) => `- ${item.dataset.reviewTitle} [${item.value}]`).join("\n");
          if (!marked.length) list.hidden = true;
          return marked.map((item) => item.value);
        }

        for (const item of items) {
          item.checked = selected.includes(item.value);
          item.closest("label")!.hidden = false;
          item.addEventListener("change", () => {
            message.textContent = "";
            try {
              localStorage.setItem(key, JSON.stringify(updateSelection()));
            } catch {
              message.textContent = "A seleção pode não ficar guardada ao fechar a página.";
            }
          });
        }

        copy.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(list.value);
            message.textContent = "Lista copiada. Podes colá-la no chat.";
          } catch {
            list.hidden = false;
            list.focus();
            list.select();
            message.textContent = "Copia o texto selecionado e cola-o no chat.";
          }
        });

        updateSelection();
        panel.hidden = false;
      }

      enableMediaReview();

      const videos = document.querySelectorAll<HTMLVideoElement>(".video-track video");
      videos.forEach((video) => {
        video.addEventListener("play", () => {
          videos.forEach((other) => {
            if (other !== video) other.pause();
          });
        });
      });
    </script>
  </body>
</html>
