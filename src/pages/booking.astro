---
import SiteHeader from "../components/SiteHeader.astro";
import GlobalMixcloudPlayer from "../components/GlobalMixcloudPlayer.astro";
import HubSpotTracking from "../components/HubSpotTracking.astro";
import MetaPixel from "../components/MetaPixel.astro";
const rehearsal = import.meta.env.DEV || Boolean(process.env.CF_PAGES_BRANCH && process.env.CF_PAGES_BRANCH !== "main");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Booking enquiries for Itchy Lemon, Porto-based DJ and producer. Club sets, selected events and music curation."
    />
    <meta name="author" content="Itchy Lemon" />
    <meta name="theme-color" content="#07090c" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Booking | Itchy Lemon</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://itchylemon.com/booking/" />

    <style>
      :root {
        --bg: #07090c;
        --bg-soft: #10141b;
        --text: #f4f4f0;
        --muted: #a7adb8;
        --acid: #d8ff3e;
        --line: rgba(255, 255, 255, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background:
          radial-gradient(circle at top right, rgba(216, 255, 62, 0.12), transparent 34%),
          linear-gradient(135deg, #07090c 0%, #111827 48%, #050608 100%);
        color: var(--text);
        min-height: 100vh;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        font: inherit;
      }

      .page {
        min-height: 100vh;
        padding: 32px;
      }

      main {
        max-width: 1080px;
        margin: 0 auto;
      }

      .eyebrow {
        color: var(--acid);
        text-transform: uppercase;
        letter-spacing: 0.24em;
        font-size: 13px;
        margin-bottom: 18px;
      }

      h1 {
        margin: 0;
        font-size: clamp(48px, 8vw, 104px);
        line-height: 0.9;
        letter-spacing: -0.06em;
        text-transform: uppercase;
      }

      .hero {display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.67fr);align-items:center;gap:clamp(24px,5vw,70px);margin:0 0 28px}
      .hero img {display:block;width:100%;height:auto;object-fit:contain;border-radius:4px}
      .lead {color:var(--text);font-size:clamp(22px,3vw,34px);line-height:1.14;letter-spacing:-.035em;margin:22px 0}
      .hero .copy {font-size:18px;color:var(--acid)}
      .copy {color:var(--muted);font-size:17px;line-height:1.6;max-width:56ch}
      .actions {display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin:26px 0 0}
      .text-link, .copy a {text-decoration:underline;text-underline-offset:5px}
      a:hover {color:var(--acid)}
      :focus-visible {outline:3px solid var(--acid);outline-offset:3px}
      .section {border-top:1px solid var(--line);padding:32px 0}
      .section h2 {color:var(--acid);font-size:13px;letter-spacing:.18em;text-transform:uppercase;margin:0 0 16px}
      .formats {display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:20px 38px;margin:22px 0 0}
      .formats div {border-top:1px solid var(--line);padding-top:14px}
      .formats dt {font-weight:700;font-size:1rem;color:var(--text)}
      .formats dd {margin:6px 0 0;color:var(--muted);line-height:1.5}
      .profiles {display:flex;flex-wrap:wrap;gap:4px 24px}
      .profiles a {font-size:20px;color:var(--text);display:inline-flex;align-items:center;min-height:44px;text-decoration:underline;text-underline-offset:5px}
      .copy a {color:var(--text);font-size:20px}
      .note {font-size:14px;color:var(--muted)}
      .test-form {display:grid;gap:14px;color:#14181c}
      .test-form label {display:grid;gap:5px}
      .test-form label.check {display:block}
      .test-form input:not([type=checkbox]),.test-form textarea,.test-form select {font:inherit;width:100%;padding:10px;border:1px solid #72777b;border-radius:4px}
      .test-form button {justify-self:start}
      .test-form [hidden], [hidden] {display:none}
      @media(max-width:720px){.hero{grid-template-columns:1fr}.hero{gap:16px;margin-bottom:20px}.hero img{width:65%;max-width:250px}.actions{gap:16px}}
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--text);
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        white-space: nowrap;
        cursor: pointer;
        transition:
          transform 0.2s ease,
          background 0.2s ease,
          border-color 0.2s ease,
          color 0.2s ease;
      }

      .button.primary {
        background: var(--acid);
        color: #050608;
        border-color: var(--acid);
      }

      .button.secondary {
        background: rgba(216, 255, 62, 0.06);
        color: var(--acid);
        border-color: var(--line);
      }

      .button:hover {
        transform: translateY(-2px);
        border-color: var(--acid);
      }

      .booking-modal {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 28px;
        background: rgba(0, 0, 0, 0.72);
        backdrop-filter: blur(12px);
      }

      .booking-modal { margin:0; width:100%; max-width:none; height:100%; max-height:none; border:0; color:var(--text); }
      .booking-modal[open] {
        display: flex;
      }

      .booking-modal-content {
        position: relative;
        width: min(760px, 96vw);
        max-height: 92vh;
        overflow-y: auto;
        border: 1px solid rgba(216, 255, 62, 0.18);
        border-radius: 32px;
        background:
          radial-gradient(circle at top right, rgba(216, 255, 62, 0.14), transparent 34%),
          rgba(7, 9, 12, 0.96);
        padding: clamp(24px, 5vw, 42px);
        box-shadow: 0 24px 90px rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(16px);
      }

      .booking-modal-label {
        margin: 0 0 16px;
        color: var(--acid);
        text-transform: uppercase;
        letter-spacing: 0.22em;
        font-size: 12px;
      }

      .booking-modal-title {
        margin: 0;
        font-size: clamp(36px, 6vw, 68px);
        line-height: 0.92;
        letter-spacing: -0.06em;
        text-transform: uppercase;
      }

      .booking-modal-copy {
        margin: 22px 0 0;
        color: rgba(244, 244, 240, 0.76);
        font-size: 17px;
        line-height: 1.7;
        max-width: 620px;
      }

      .booking-modal-form {
        margin-top: 28px;
        border: 1px solid rgba(216, 255, 62, 0.22);
        border-radius: 24px;
        background: #ffffff;
        padding: 22px;
        overflow: hidden;
      }

      .booking-modal-form iframe {
        width: 100%;
        background: #ffffff;
        border: 0;
      }

      .booking-modal-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
      }

      .booking-modal-close {
        position: absolute;
        top: 18px;
        right: 18px;
        width: 42px;
        height: 42px;
        border: 1px solid rgba(244, 244, 240, 0.14);
        border-radius: 999px;
        background: rgba(16, 20, 27, 0.9);
        color: var(--acid);
        cursor: pointer;
        font-size: 22px;
        line-height: 1;
      }

      .booking-modal-close:hover {
        border-color: var(--acid);
      }

      footer {
        max-width: 1080px;
        margin: 80px auto 0;
        color: var(--muted);
        font-size: 12px;
        padding-top: 28px;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        gap: 20px;
      }

      footer a {
        color: var(--muted);
      }

      footer a:hover {
        color: var(--acid);
      }

      @media (max-width: 1024px) {
        .page {
          padding: 22px;
        }

        .button {
          width: 100%;
        }

        footer {
          flex-direction: column;
        }
      }

      @media (max-width: 900px) {
        .booking-grid {
          grid-template-columns: 1fr;
          margin-top: 48px;
        }

        .panel.wide {
          grid-column: span 1;
        }
      }

      @media (max-width: 860px) {
        .contact-link,
        .quick-link {
          align-items: flex-start;
          flex-direction: column;
          gap: 8px;
        }

        .booking-modal {
          padding: 16px;
        }

        .booking-modal-content {
          border-radius: 24px;
        }

        .booking-modal-actions {
          flex-direction: column;
        }
      }
    </style>
  </head>

  <body>
    <div class="page">
      <SiteHeader activePage="booking" />

      <main>
        <section class="hero" aria-labelledby="booking-title">
          <div>
            <p class="eyebrow">Itchy Lemon · DJ &amp; producer</p>
            <h1 id="booking-title">Booking</h1>
            <p class="lead">Deep grooves, melodic tension and an instinct for the dancefloor.</p>
            <p class="copy">Based in Porto, Itchy Lemon has played across Portugal and in London, Amsterdam and Luxembourg. His club sets weave his own productions into a selection that evolves with the dancefloor.</p>
            <div class="actions">
              <a class="button primary" href="/press-kit/">Press Kit</a>
              <a class="text-link" href="/sets/">Listen to a set</a>
            </div>
          </div>
          <img src="/media/archive/monochrome-dj-booth.webp" alt="Itchy Lemon reaching across the mixer during a DJ set" width="960" height="639" fetchpriority="high" draggable="false" />
        </section>
        <section class="section"><h2>Available for</h2>
          <dl class="formats">
            <div><dt>Club DJ sets</dt><dd>Melodic, groove-led selections shaped around the room and the slot.</dd></div>
            <div><dt>Electronic music events</dt><dd>DJ appearances and music curation for selected events.</dd></div>
            <div><dt>Guest mixes</dt><dd>Recorded sets for radio programmes, podcasts and guest series.</dd></div>
            <div><dt>Collaborations</dt><dd>Remixes, original productions and selected label projects.</dd></div>
          </dl>
        </section>
        <section class="section"><h2>Booking enquiries</h2>
          <p class="copy">For a club night, share the date, venue and city. If the line-up is taking shape, let us know where you hear Itchy Lemon fitting into the night.</p>
          <div class="actions">
            <button type="button" class="button primary" data-open-booking-modal>Enquire about a date</button>
            <a class="button secondary" href="mailto:booking@itchylemon.com">Email booking</a>
          </div>
        </section>
        <section class="section"><h2>Verification Links</h2>
          <nav class="profiles" aria-label="Official artist profiles">
            <a href="https://open.spotify.com/artist/5IfFyzIiz1iBO7RZUJyFen">Spotify</a>
            <a href="https://www.mixcloud.com/ITCHY_LEMON_DjProducer/">Mixcloud</a>
            <a href="https://www.instagram.com/itchy_lemon/">Instagram</a>
            <a href="https://www.facebook.com/ItchyLemondjproducer">Facebook</a>
            <a href="https://www.youtube.com/@ItchyLemonTV">YouTube</a>
            <a href="https://www.beatport.com/artist/itchy-lemon/339277">Beatport</a>
            <a href="https://www.traxsource.com/artist/131494/itchy-lemon">Traxsource</a>
          </nav>
        </section>
      </main>

      <footer>
        <span>© 2026 Itchy Lemon. All rights reserved.</span>
        <span>
          Portugal · Bookings · Guest mixes · Selected collaborations ·
          <a href="/privacy-policy">Privacy Policy</a>
        </span>
      </footer>
    </div>

    <dialog class="booking-modal" data-booking-modal aria-labelledby="request-title">
      <div
        class="booking-modal-content"

      >
        <button
          class="booking-modal-close"
          type="button"
          data-close-booking-modal
          aria-label="Close booking popup"
        >
          ×
        </button>

        <p class="booking-modal-label">Booking Request</p>

        <h2 class="booking-modal-title" id="request-title">
          Event enquiry
        </h2>

        <p class="booking-modal-copy">
          Include the date or date range, venue and city if known. We’ll reply by email to discuss availability and details.
        </p>

        <div class="booking-modal-form">
          {rehearsal ? <div><form class="test-form" data-rehearsal>
            <strong>Preview form · use fictional details</strong><span>This rehearsal runs on your device. Nothing is sent.</span>
            <label>Name<input required /></label><label>Email<input required type="email" /></label>
            <label>Company or organisation (optional)<input /></label><label>Event or venue<input /></label>
            <label>Contact interest<select><option>Booking</option><option>Guest mix</option><option>Collaboration</option></select></label>
            <label>Event details<textarea required rows="3" placeholder="Date, city and a little about the night"></textarea></label>
            <label>Phone (optional)<input type="tel" /></label>
            <label class="check"><input required type="checkbox" /> I agree to the use of these details to handle this enquiry.</label>
            <label class="check"><input type="checkbox" /> I’d like to receive artist news (optional).</label>
            <button class="button primary" type="submit">Test enquiry</button>
          </form><p hidden tabindex="-1" data-receipt style="color:#171a20">Preview complete. In the live form, confirmation follows a successful submission. A booking is agreed separately.</p></div> : <div
            class="hs-form-frame"
            data-region="eu1"
            data-form-id="06399ad4-ccd6-4cfa-a1a0-9b7eb2d587a2"
            data-portal-id="148590426"
          ></div>}
        </div>

        <div class="booking-modal-actions">
          <a class="button secondary" href="/privacy-policy/">
            Privacy policy
          </a>

          <a class="button secondary" href="mailto:booking@itchylemon.com">
            Email Directly
          </a>
        </div>
      </div>
    </dialog>

    { !rehearsal && <> <MetaPixel />
    <GlobalMixcloudPlayer />
    <HubSpotTracking />

    <script src="https://js-eu1.hsforms.net/forms/embed/148590426.js" defer></script></> }

    <script>
      const bookingFormId = "06399ad4-ccd6-4cfa-a1a0-9b7eb2d587a2";

      const bookingModal = document.querySelector("[data-booking-modal]");
      const bookingModalTriggers = document.querySelectorAll(
        "[data-open-booking-modal]"
      );
      const bookingModalClose = document.querySelector(
        "[data-close-booking-modal]"
      );

      // Only accept legacy HubSpot callbacks from trusted origins.
      const isTrustedHubSpotOrigin = (origin) => {
        if (origin === window.location.origin) {
          return true;
        }

        try {
          const url = new URL(origin);
          const trustedDomains = [
            "hsforms.com",
            "hsforms.net",
            "hubspot.com",
            "hs-sites.com",
          ];

          return (
            url.protocol === "https:" &&
            trustedDomains.some(
              (domain) =>
                url.hostname === domain ||
                url.hostname.endsWith(`.${domain}`)
            )
          );
        } catch {
          return false;
        }
      };

      const hasMetaConsent = () => {
        try {
          return localStorage.getItem("itchyLemonTrackingConsentV2") === "granted";
        } catch {
          return false;
        }
      };

      let bookingLeadTracked = false;

      const trackBookingIntent = (trigger) => {
        if (!hasMetaConsent() || typeof window.fbq !== "function") {
          return;
        }

        const triggerLabel =
          trigger?.textContent?.trim().replace(/\s+/g, " ") ||
          "Booking Request";

        window.fbq("trackCustom", "BookingIntent", {
          source_page: "booking",
          trigger_label: triggerLabel,
          form_id: bookingFormId,
        });
      };

      const trackBookingLead = () => {
        if (
          bookingLeadTracked ||
          !hasMetaConsent() || typeof window.fbq !== "function"
        ) {
          return;
        }

        window.fbq("track", "Lead", {
          content_name: "Booking Request",
          content_category: "Booking",
          source_page: "booking",
          form_id: bookingFormId,
        });

        bookingLeadTracked = true;
      };

      const testForm = document.querySelector("[data-rehearsal]");
      const receipt = document.querySelector("[data-receipt]");
      testForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        testForm.hidden = true;
        receipt.hidden = false;
        receipt.focus();
      });
      const openBookingModal = (trigger) => {
        bookingModal.showModal();
        document.body.style.overflow = "hidden";
        trackBookingIntent(trigger);
      };
      const closeBookingModal = () => bookingModal.close();
      bookingModal.addEventListener("close", () => {
        document.body.style.overflow = "";
        if (receipt && !receipt.hidden) {
          testForm.reset();
          testForm.hidden = false;
          receipt.hidden = true;
        }
      });
      bookingModalTriggers.forEach((trigger) => {
        trigger.addEventListener("click", (event) => {
          event.preventDefault();
          openBookingModal(trigger);
        });
      });

      bookingModalClose?.addEventListener("click", closeBookingModal);

      bookingModal?.addEventListener("click", (event) => {
        if (event.target === bookingModal) {
          closeBookingModal();
        }
      });

      /*
       * Current HubSpot forms:
       * fires only after a successful form submission.
       */
      window.addEventListener(
        "hs-form-event:on-submission:success",
        (event) => {
          const submittedFormId = event.detail?.formId || "";

          if (submittedFormId !== bookingFormId) {
            return;
          }

          trackBookingLead();
        }
      );

      /*
       * Legacy HubSpot forms fallback.
       * bookingLeadTracked prevents duplicate Meta Lead events.
       */
      window.addEventListener("message", (event) => {
        if (!isTrustedHubSpotOrigin(event.origin)) {
          return;
        }

        if (
          !event.data ||
          event.data.type !== "hsFormCallback" ||
          event.data.eventName !== "onFormSubmitted"
        ) {
          return;
        }

        const submittedFormId =
          event.data.id ||
          event.data.formId ||
          "";

        if (submittedFormId !== bookingFormId) {
          return;
        }

        trackBookingLead();
      });
    </script>
  </body>
</html>