---
import SiteHeader from "../components/SiteHeader.astro";
import GlobalMixcloudPlayer from "../components/GlobalMixcloudPlayer.astro";
import HubSpotTracking from "../components/HubSpotTracking.astro";
import MetaPixel from "../components/MetaPixel.astro";
const rehearsal = import.meta.env.DEV || Boolean(process.env.CF_PAGES_BRANCH && process.env.CF_PAGES_BRANCH !== "main");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Booking enquiries for Itchy Lemon, Porto-based DJ and producer. Club sets, selected events and music curation."
    />
    <meta name="author" content="Itchy Lemon" />
    <meta name="theme-color" content="#07090c" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Booking | Itchy Lemon</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://itchylemon.com/booking/" />

    <style>
      :root {
        --bg: #07090c;
        --bg-soft: #10141b;
        --text: #f4f4f0;
        --muted: #a7adb8;
        --acid: #d8ff3e;
        --line: rgba(255, 255, 255, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background:
          radial-gradient(circle at top right, rgba(216, 255, 62, 0.12), transparent 34%),
          linear-gradient(135deg, #07090c 0%, #111827 48%, #050608 100%);
        color: var(--text);
        min-height: 100vh;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        font: inherit;
      }

      .page {
        min-height: 100vh;
        padding: 32px;
      }

      main {
        max-width: 1080px;
        margin: 0 auto;
      }

      .eyebrow {
        color: var(--acid);
        text-transform: uppercase;
        letter-spacing: 0.24em;
        font-size: 13px;
        margin-bottom: 18px;
      }

      h1 {
        margin: 0;
        font-size: clamp(48px, 8vw, 104px);
        line-height: 0.9;
        letter-spacing: -0.06em;
        text-transform: uppercase;
      }

      .lead {
        margin-top: 32px;
        max-width: 780px;
        font-size: clamp(22px, 3vw, 34px);
        line-height: 1.16;
        color: var(--text);
      }

      .cta-panel {
        margin-top: 48px;
        border: 1px solid var(--line);
        border-radius: 28px;
        background:
          linear-gradient(135deg, rgba(216, 255, 62, 0.1), transparent),
          rgba(16, 20, 27, 0.72);
        padding: 28px;
        backdrop-filter: blur(12px);
      }

      .cta-panel p {
        margin: 0;
        max-width: 760px;
        color: var(--muted);
        font-size: 18px;
        line-height: 1.7;
      }

      .cta-panel strong {
        color: var(--text);
      }

      .cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 24px;
      }

      .booking-grid {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        gap: 28px;
        margin-top: 72px;
      }

      .panel {
        border: 1px solid var(--line);
        background: rgba(16, 20, 27, 0.72);
        border-radius: 28px;
        padding: 28px;
        backdrop-filter: blur(12px);
      }

      .panel.wide {
        grid-column: span 2;
      }

      .panel h2 {
        margin: 0 0 20px;
        color: var(--acid);
        font-size: 13px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .panel p {
        color: var(--muted);
        font-size: 17px;
        line-height: 1.7;
        margin: 0 0 20px;
      }

      .panel strong {
        color: var(--text);
      }

      .services {
        display: grid;
        gap: 16px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .services li {
        border-top: 1px solid var(--line);
        padding-top: 16px;
        color: var(--muted);
        line-height: 1.5;
      }

      .services strong {
        display: block;
        color: var(--text);
        margin-bottom: 4px;
      }

      .form-note {
        color: var(--muted);
        font-size: 13px;
        line-height: 1.6;
      }

      .contact-link,
      .quick-link {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        border-top: 1px solid var(--line);
        padding: 18px 0;
        color: var(--muted);
      }

      .contact-link strong,
      .quick-link strong {
        color: var(--text);
        font-size: 20px;
      }

      .contact-link span,
      .quick-link span {
        color: var(--acid);
        text-transform: uppercase;
        letter-spacing: 0.16em;
        font-size: 12px;
      }

      .contact-link:hover strong,
      .quick-link:hover strong {
        color: var(--acid);
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--text);
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        white-space: nowrap;
        cursor: pointer;
        transition:
          transform 0.2s ease,
          background 0.2s ease,
          border-color 0.2s ease,
          color 0.2s ease;
      }

      .button.primary {
        background: var(--acid);
        color: #050608;
        border-color: var(--acid);
      }

      .button.secondary {
        background: rgba(216, 255, 62, 0.06);
        color: var(--acid);
        border-color: var(--line);
      }

      .button:hover {
        transform: translateY(-2px);
        border-color: var(--acid);
      }

      .booking-modal {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 28px;
        background: rgba(0, 0, 0, 0.72);
        backdrop-filter: blur(12px);
      }

      .booking-photo {float:right;width:min(26%,230px);height:auto;margin:0 0 12px 20px;border-radius:16px}
      .cta-panel {clear:both}
      @media(max-width:600px){.booking-photo{width:90px;margin-left:10px}}
      .booking-modal {margin:0;width:100%;max-width:none;height:100%;max-height:none;border:0;color:var(--text)}
      .booking-modal[open] {
        display: flex;
      }

      .booking-modal-content {
        position: relative;
        width: min(760px, 96vw);
        max-height: 92vh;
        overflow-y: auto;
        border: 1px solid rgba(216, 255, 62, 0.18);
        border-radius: 32px;
        background:
          radial-gradient(circle at top right, rgba(216, 255, 62, 0.14), transparent 34%),
          rgba(7, 9, 12, 0.96);
        padding: clamp(24px, 5vw, 42px);
        box-shadow: 0 24px 90px rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(16px);
      }

      .booking-modal-label {
        margin: 0 0 16px;
        color: var(--acid);
        text-transform: uppercase;
        letter-spacing: 0.22em;
        font-size: 12px;
      }

      .booking-modal-title {
        margin: 0;
        font-size: clamp(36px, 6vw, 68px);
        line-height: 0.92;
        letter-spacing: -0.06em;
        text-transform: uppercase;
      }

      .booking-modal-copy {
        margin: 22px 0 0;
        color: rgba(244, 244, 240, 0.76);
        font-size: 17px;
        line-height: 1.7;
        max-width: 620px;
      }

      .booking-modal-form {
        margin-top: 28px;
        border: 1px solid rgba(216, 255, 62, 0.22);
        border-radius: 24px;
        background: #ffffff;
        padding: 22px;
        overflow: hidden;
      }

      .booking-modal-form iframe {
        width: 100%;
        background: #ffffff;
        border: 0;
      }

      .booking-modal-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
      }

      .booking-modal-close {
        position: absolute;
        top: 18px;
        right: 18px;
        width: 42px;
        height: 42px;
        border: 1px solid rgba(244, 244, 240, 0.14);
        border-radius: 999px;
        background: rgba(16, 20, 27, 0.9);
        color: var(--acid);
        cursor: pointer;
        font-size: 22px;
        line-height: 1;
      }

      .booking-modal-close:hover {
        border-color: var(--acid);
      }

      footer {
        max-width: 1080px;
        margin: 80px auto 0;
        color: var(--muted);
        font-size: 12px;
        padding-top: 28px;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        gap: 20px;
      }

      footer a {
        color: var(--muted);
      }

      footer a:hover {
        color: var(--acid);
      }

      @media (max-width: 1024px) {
        .page {
          padding: 22px;
        }

        .button {
          width: 100%;
        }

        footer {
          flex-direction: column;
        }
      }

      @media (max-width: 900px) {
        .booking-grid {
          grid-template-columns: 1fr;
          margin-top: 48px;
        }

        .panel.wide {
          grid-column: span 1;
        }
      }

      @media (max-width: 860px) {
        .contact-link,
        .quick-link {
          align-items: flex-start;
          flex-direction: column;
          gap: 8px;
        }

        .booking-modal {
          padding: 16px;
        }

        .booking-modal-content {
          border-radius: 24px;
        }

        .booking-modal-actions {
          flex-direction: column;
        }
      }
      .test-form {display:grid;gap:14px;color:#14181c}
      .test-form label {display:grid;gap:5px}
      .test-form label.check {display:block}
      .test-form input:not([type=checkbox]),.test-form textarea,.test-form select {font:inherit;width:100%;padding:10px;border:1px solid #72777b;border-radius:4px}
      .test-form button {justify-self:start}
      .test-form [hidden], [hidden] {display:none}
    </style>
  </head>

  <body>
    <div class="page">
      <SiteHeader activePage="booking" />

      <main>
        <img class="booking-photo" src="/media/archive/monochrome-dj-booth.webp" alt="Itchy Lemon at the mixer" width="960" height="639" />
        <p class="eyebrow">Itchy Lemon · DJ &amp; producer</p>
        <h1>Booking</h1>
        <p class="lead">Deep grooves, melodic tension and an instinct for the dancefloor.</p>
        <section class="cta-panel" aria-label="Booking introduction">
          <p>Based in Porto, Itchy Lemon brings original productions into DJ sets shaped by the room. His club appearances span Portugal and London, from Orange Room to Ministry of Sound.</p>
          <div class="cta-actions"><a class="button primary" href="/press-kit/">Press Kit</a><a class="button secondary" href="/sets/">Listen to a set</a></div>
        </section>
        <section class="booking-grid">
          <article class="panel">
            <h2>Available for</h2>

            <ul class="services">
              <li>
                <strong>Club DJ sets</strong>
                Melodic, groove-led selections shaped around the room and the slot.
              </li>

              <li>
                <strong>Guest mixes</strong>
                Recorded sets for radio programmes, podcasts and guest series.
              </li>

              <li>
                <strong>Electronic music events</strong>
                DJ appearances and music curation for selected events.
              </li>

              <li>
                <strong>Collaborations</strong>
                Remixes, original productions and selected label projects.
              </li>
            </ul>
          </article>

          <article class="panel">
            <h2>Booking Request</h2>

            <p>For a club night, share the date, venue and city. If the line-up is taking shape, let us know where you hear Itchy Lemon fitting into the night.</p>
            <div class="cta-actions"><button class="button primary" type="button" data-open-booking-modal>Enquire about a date</button>
            <a class="button secondary" href="mailto:booking@itchylemon.com">Email booking</a></div>
          </article>

          <article class="panel wide">
            <h2>Verification Links</h2>
            <a
              class="quick-link"
              href="https://open.spotify.com/artist/5IfFyzIiz1iBO7RZUJyFen"
              target="_blank"
              rel="noreferrer"
            >
              <strong>Spotify</strong>
              <span>Listen</span>
            </a>

            <a
              class="quick-link"
              href="https://www.mixcloud.com/ITCHY_LEMON_DjProducer/"
              target="_blank"
              rel="noreferrer"
            >
              <strong>Mixcloud</strong>
              <span>Sets</span>
            </a>

            <a
              class="quick-link"
              href="https://www.instagram.com/itchy_lemon/"
              target="_blank"
              rel="noreferrer"
            >
              <strong>Instagram</strong>
              <span>Follow</span>
            </a>

            <a
              class="quick-link"
              href="https://www.facebook.com/ItchyLemondjproducer"
              target="_blank"
              rel="noreferrer"
            >
              <strong>Facebook</strong>
              <span>Follow</span>
            </a>

            <a
              class="quick-link"
              href="https://www.youtube.com/@ItchyLemonTV"
              target="_blank"
              rel="noreferrer"
            >
              <strong>YouTube</strong>
              <span>Watch</span>
            </a>

            <a
              class="quick-link"
              href="https://www.beatport.com/artist/itchy-lemon/339277"
              target="_blank"
              rel="noreferrer"
            >
              <strong>Beatport</strong>
              <span>Artist page</span>
            </a>

            <a
              class="quick-link"
              href="https://www.traxsource.com/artist/131494/itchy-lemon"
              target="_blank"
              rel="noreferrer"
            >
              <strong>Traxsource</strong>
              <span>Artist page</span>
            </a>
          </article>
          <article class="panel wide"><h2>Selected appearances</h2><ul class="services">
              <li><strong>Ministry of Sound · London · 2014</strong>DJ set at La Bomba, 26 December. <a href="https://www.fatsoma.com/e/tum8nley/la-bomba"><u>Event listing</u></a></li>
              <li><strong>Orange Room · Porto · 2015</strong>Fresh Beats #40, recorded live in the club. <a href="https://www.mixcloud.com/ITCHY_LEMON_DjProducer/itchy-lemon-fresh-beats-40-rec-live-at-orange-room-porto-studio-series-episode-108-dec-2015/"><u>Hear the club set</u></a></li>
              <li><strong>Ibiza Stardust Radio · Radio · 2026</strong>Fresh Beats #42, from the radio residency. <a href="https://soundcloud.com/ibizastardustradio/itchy-lemon-fresh-beats-42"><u>Hear the radio mix</u></a></li>
            </ul></article>
        </section>
      </main>

      <footer>
        <span>© 2026 Itchy Lemon. All rights reserved.</span>
        <span>
          Portugal · Bookings · Guest mixes · Selected collaborations ·
          <a href="/privacy-policy">Privacy Policy</a>
        </span>
      </footer>
    </div>

    <dialog class="booking-modal" data-booking-modal aria-labelledby="request-title">
      <div
        class="booking-modal-content"

      >
        <button
          class="booking-modal-close"
          type="button"
          data-close-booking-modal
          aria-label="Close booking popup"
        >
          ×
        </button>

        <p class="booking-modal-label">Booking Request</p>

        <h2 class="booking-modal-title" id="request-title">
          Event enquiry
        </h2>

        <p class="booking-modal-copy">
          Include the date or date range, venue and city if known. We’ll reply by email to discuss availability and details.
        </p>

        <div class="booking-modal-form">
          {rehearsal ? <div><form class="test-form" data-rehearsal>
            <strong>Preview form · use fictional details</strong><span>This rehearsal runs on your device. Nothing is sent.</span>
            <label>Name<input required /></label><label>Email<input required type="email" /></label>
            <label>Company or organisation (optional)<input /></label><label>Event or venue<input /></label>
            <label>Contact interest<select><option>Booking</option><option>Guest mix</option><option>Collaboration</option></select></label>
            <label>Event details<textarea required rows="3" placeholder="Date, city and a little about the night"></textarea></label>
            <label>Phone (optional)<input type="tel" /></label>
            <label class="check"><input required type="checkbox" /> I agree to the use of these details to handle this enquiry.</label>
            <label class="check"><input type="checkbox" /> I’d like to receive artist news (optional).</label>
            <button class="button primary" type="submit">Test enquiry</button>
          </form><p hidden tabindex="-1" data-receipt style="color:#171a20">Preview complete. In the live form, confirmation follows a successful submission. A booking is agreed separately.</p></div> : <div
            class="hs-form-frame"
            data-region="eu1"
            data-form-id="06399ad4-ccd6-4cfa-a1a0-9b7eb2d587a2"
            data-portal-id="148590426"
          ></div>}
        </div>

        <div class="booking-modal-actions">
          <a class="button secondary" href="/privacy-policy/">
            Privacy policy
          </a>

          <a class="button secondary" href="mailto:booking@itchylemon.com">
            Email Directly
          </a>
        </div>
      </div>
    </dialog>

    { !rehearsal && <> <MetaPixel />
    <GlobalMixcloudPlayer />
    <HubSpotTracking />

    <script src="https://js-eu1.hsforms.net/forms/embed/148590426.js" defer></script></> }

    <script>
      const bookingFormId = "06399ad4-ccd6-4cfa-a1a0-9b7eb2d587a2";

      const bookingModal = document.querySelector("[data-booking-modal]");
      const bookingModalTriggers = document.querySelectorAll(
        "[data-open-booking-modal]"
      );
      const bookingModalClose = document.querySelector(
        "[data-close-booking-modal]"
      );

      // Only accept legacy HubSpot callbacks from trusted origins.
      const isTrustedHubSpotOrigin = (origin) => {
        if (origin === window.location.origin) {
          return true;
        }

        try {
          const url = new URL(origin);
          const trustedDomains = [
            "hsforms.com",
            "hsforms.net",
            "hubspot.com",
            "hs-sites.com",
          ];

          return (
            url.protocol === "https:" &&
            trustedDomains.some(
              (domain) =>
                url.hostname === domain ||
                url.hostname.endsWith(`.${domain}`)
            )
          );
        } catch {
          return false;
        }
      };

      const hasMetaConsent = () => {
        try {
          return localStorage.getItem("itchyLemonTrackingConsentV2") === "granted";
        } catch {
          return false;
        }
      };

      let bookingLeadTracked = false;

      const trackBookingIntent = (trigger) => {
        if (!hasMetaConsent() || typeof window.fbq !== "function") {
          return;
        }

        const triggerLabel =
          trigger?.textContent?.trim().replace(/\s+/g, " ") ||
          "Booking Request";

        window.fbq("trackCustom", "BookingIntent", {
          source_page: "booking",
          trigger_label: triggerLabel,
          form_id: bookingFormId,
        });
      };

      const trackBookingLead = () => {
        if (
          bookingLeadTracked ||
          !hasMetaConsent() || typeof window.fbq !== "function"
        ) {
          return;
        }

        window.fbq("track", "Lead", {
          content_name: "Booking Request",
          content_category: "Booking",
          source_page: "booking",
          form_id: bookingFormId,
        });

        bookingLeadTracked = true;
      };

      const testForm = document.querySelector("[data-rehearsal]");
      const receipt = document.querySelector("[data-receipt]");
      testForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        testForm.hidden = true;
        receipt.hidden = false;
        receipt.focus();
      });
      const openBookingModal = (trigger) => {
        bookingModal.showModal();
        document.body.style.overflow = "hidden";
        trackBookingIntent(trigger);
      };
      const closeBookingModal = () => bookingModal.close();
      bookingModal.addEventListener("close", () => {
        document.body.style.overflow = "";
        if (receipt && !receipt.hidden) {
          testForm.reset();
          testForm.hidden = false;
          receipt.hidden = true;
        }
      });
      bookingModalTriggers.forEach((trigger) => {
        trigger.addEventListener("click", (event) => {
          event.preventDefault();
          openBookingModal(trigger);
        });
      });

      bookingModalClose?.addEventListener("click", closeBookingModal);

      bookingModal?.addEventListener("click", (event) => {
        if (event.target === bookingModal) {
          closeBookingModal();
        }
      });

      /*
       * Current HubSpot forms:
       * fires only after a successful form submission.
       */
      window.addEventListener(
        "hs-form-event:on-submission:success",
        (event) => {
          const submittedFormId = event.detail?.formId || "";

          if (submittedFormId !== bookingFormId) {
            return;
          }

          trackBookingLead();
        }
      );

      /*
       * Legacy HubSpot forms fallback.
       * bookingLeadTracked prevents duplicate Meta Lead events.
       */
      window.addEventListener("message", (event) => {
        if (!isTrustedHubSpotOrigin(event.origin)) {
          return;
        }

        if (
          !event.data ||
          event.data.type !== "hsFormCallback" ||
          event.data.eventName !== "onFormSubmitted"
        ) {
          return;
        }

        const submittedFormId =
          event.data.id ||
          event.data.formId ||
          "";

        if (submittedFormId !== bookingFormId) {
          return;
        }

        trackBookingLead();
      });
    </script>
  </body>
</html>