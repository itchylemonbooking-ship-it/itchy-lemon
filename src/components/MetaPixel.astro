<script is:inline>
  (() => {
    const pixelId = "2110078442878718";
    const consentKey = "itchyLemonMetaConsent";

    let metaPixelLoaded = false;

    const getStoredConsent = () => {
      try {
        return localStorage.getItem(consentKey);
      } catch {
        return null;
      }
    };

    const storeConsent = (value) => {
      try {
        localStorage.setItem(consentKey, value);
      } catch {
        // Consent applies only to the current page if storage is unavailable.
      }
    };

    const createFbq = () => {
      if (window.fbq) {
        return window.fbq;
      }

      !function(f,b,e,v,n,t,s)
      {
        if(f.fbq)return;

        n=f.fbq=function(){
          n.callMethod
            ? n.callMethod.apply(n,arguments)
            : n.queue.push(arguments)
        };

        if(!f._fbq)f._fbq=n;

        n.push=n;
        n.loaded=!0;
        n.version='2.0';
        n.queue=[];

        t=b.createElement(e);
        t.async=!0;
        t.src=v;

        s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s);

      }(
        window,
        document,
        'script',
        'https://connect.facebook.net/en_US/fbevents.js'
      );

      return window.fbq;
    };

    const loadMetaPixel = () => {
      if (metaPixelLoaded && typeof window.fbq === "function") {
        window.fbq("consent", "grant");
        return;
      }

      const fbq = createFbq();

      fbq("consent", "grant");
      fbq("init", pixelId);
      fbq("track", "PageView");

      metaPixelLoaded = true;
    };

    const revokeMetaPixel = () => {
      if (typeof window.fbq === "function") {
        window.fbq("consent", "revoke");
      }
    };

    /*
     * Returning visitor:
     * only load Meta if consent was previously granted.
     */
    if (getStoredConsent() === "granted") {
      loadMetaPixel();
    }

    document.addEventListener("DOMContentLoaded", () => {
      const banner = document.querySelector("[data-meta-consent]");
      const acceptButton = document.querySelector(
        "[data-meta-consent-accept]"
      );
      const rejectButton = document.querySelector(
        "[data-meta-consent-reject]"
      );
      const settingsButton = document.querySelector(
        "[data-meta-consent-settings]"
      );

      if (!banner) {
        return;
      }

      const updateConsentInterface = () => {
        const consent = getStoredConsent();

        if (consent === "granted" || consent === "denied") {
          banner.hidden = true;

          if (settingsButton) {
            settingsButton.hidden = false;
          }

          return;
        }

        banner.hidden = false;

        if (settingsButton) {
          settingsButton.hidden = true;
        }
      };

      acceptButton?.addEventListener("click", () => {
        storeConsent("granted");

        loadMetaPixel();

        banner.hidden = true;

        if (settingsButton) {
          settingsButton.hidden = false;
        }
      });

      rejectButton?.addEventListener("click", () => {
        storeConsent("denied");

        revokeMetaPixel();

        banner.hidden = true;

        if (settingsButton) {
          settingsButton.hidden = false;
        }
      });

      settingsButton?.addEventListener("click", () => {
        banner.hidden = false;
        settingsButton.hidden = true;
      });

      updateConsentInterface();
    });
  })();
</script>

