<script is:inline>
  (() => {
    const consentKey = "itchyLemonTrackingConsentV2";
    const analyticsCookies = ["__hstc", "hubspotutk", "__hssc", "__hssrc"];

    const updateTracking = (granted) => {
      const queue = window._hsq = window._hsq || [];

      if (granted) {
        queue.push(["doNotTrack", { track: true }]);
        return;
      }

      queue.push(["doNotTrack"]);
      for (const name of analyticsCookies) {
        const expired = `${name}=; Max-Age=0; Path=/`;
        document.cookie = expired;
        document.cookie = `${expired}; Domain=itchylemon.com`;
      }
    };

    let granted = false;
    try {
      granted = localStorage.getItem(consentKey) === "granted";
    } catch {
      // Keep analytics disabled when storage is unavailable.
    }

    updateTracking(granted);
    window.addEventListener("itchylemon:tracking-consent", (event) => {
      updateTracking(event.detail === "granted");
    });
  })();
</script>

