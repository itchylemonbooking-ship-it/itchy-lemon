<script is:inline>
  (() => {
    const consentKey = "itchyLemonTrackingConsentV2";
    const analyticsCookies = ["__hstc", "hubspotutk", "__hssc", "__hssrc"];
    let trackingLoaded = false;

    const enableTracking = () => {
      if (trackingLoaded) return;
      trackingLoaded = true;
      (window._hsq = window._hsq || []).push(["doNotTrack", { track: true }]);
      const loader = document.createElement("script");
      loader.id = "hs-script-loader";
      loader.src = "https://js-eu1.hs-scripts.com/148590426.js";
      loader.async = true;
      document.head.appendChild(loader);
    };

    const clearAnalyticsCookies = () => {
      for (const name of analyticsCookies) {
        const expired = name + "=; Max-Age=0; Path=/";
        document.cookie = expired;
        if (location.hostname === "itchylemon.com" || location.hostname.endsWith(".itchylemon.com")) {
          document.cookie = expired + "; Domain=itchylemon.com";
        }
      }
    };

    const loadChat = () => {
      // The portal loader uses this ID to avoid loading Conversations twice.
      const chat = document.createElement("script");
      chat.id = "hubspot-messages-loader";
      chat.src = "https://js-eu1.usemessages.com/conversations-embed.js";
      chat.async = true;
      chat.dataset.loader = "hs-scriptloader";
      chat.dataset.hsjsPortal = "148590426";
      chat.dataset.hsjsEnv = "prod";
      chat.dataset.hsjsHublet = "eu1";
      document.head.appendChild(chat);
    };

    let granted = false;
    try {
      granted = localStorage.getItem(consentKey) === "granted";
    } catch {
      // Optional tracking stays disabled without a stored choice.
    }
    if (granted) {
      enableTracking();
    } else {
      clearAnalyticsCookies();
      loadChat();
    }

    window.addEventListener("itchylemon:tracking-consent", (event) => {
      if (event.detail === "granted") {
        enableTracking();
      } else {
        if (trackingLoaded) (window._hsq = window._hsq || []).push(["doNotTrack"]);
        clearAnalyticsCookies();
        // Unload the active analytics SDK after revocation.
        if (trackingLoaded) window.setTimeout(() => location.reload(), 0);
      }
    });
  })();
</script>
